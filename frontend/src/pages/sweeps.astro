---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Market Sweeps">
  <main class="mx-auto max-w-7xl space-y-8 p-6 lg:p-10">
    <section>
      <p class="text-sm uppercase tracking-[0.18em] text-neutral-500">Lead Desk</p>
      <h1 class="mt-2 text-3xl font-semibold text-neutral-950">Market Sweeps</h1>
      <p class="mt-2 max-w-4xl text-sm leading-6 text-neutral-600">
        Discover local businesses in any U.S. city. Choose the business categories you want, add one or more cities through Google Places, and run the sweep against that explicit market scope.
      </p>
    </section>

    <section id="execution-warning" class="hidden rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">
      Sweep execution is currently disabled. Existing prospect inventory remains available, but no new market refresh can start until execution is enabled.
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <p class="text-xs uppercase tracking-wider text-neutral-500">Coverage</p>
        <p class="mt-2 text-lg font-semibold text-neutral-950">United States</p>
      </div>
      <div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <p class="text-xs uppercase tracking-wider text-neutral-500">City targeting</p>
        <p class="mt-2 text-lg font-semibold text-neutral-950">Google Places</p>
      </div>
      <div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <p class="text-xs uppercase tracking-wider text-neutral-500">Preset verticals</p>
        <p id="market-vertical-count" class="mt-2 text-lg font-semibold text-neutral-950">—</p>
      </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-[1.25fr_0.75fr]">
      <section class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
        <div>
          <h2 class="text-lg font-semibold text-neutral-950">Sweep scope</h2>
          <p class="mt-1 text-sm text-neutral-500">
            Select any preset or custom business category, then add the U.S. cities you want to target.
          </p>
        </div>

        <form id="sweep-form" class="mt-6 space-y-6">
          <div>
            <div class="flex items-center justify-between gap-3">
              <label class="text-sm font-medium text-neutral-800">Verticals</label>
              <span id="vertical-selection-count" class="text-xs text-neutral-500">—</span>
            </div>
            <div id="vertical-options" class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4"></div>

            <div class="mt-4 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
              <label for="custom-verticals" class="block text-sm font-medium text-neutral-800">Custom verticals</label>
              <p class="mt-1 text-xs leading-5 text-neutral-500">
                Enter any business category. Use commas or new lines for more than one. Each category becomes its own Google Places search term.
              </p>
              <textarea id="custom-verticals" rows="3" placeholder="dentist&#10;med spa&#10;personal injury attorney" class="mt-3 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm"></textarea>
            </div>
          </div>

          <div>
            <div>
              <label class="text-sm font-medium text-neutral-800">Target cities</label>
              <p class="mt-1 text-xs text-neutral-500">Add one or more U.S. cities. There is no default market and no preset service area.</p>
            </div>

            <div class="relative mt-3 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
              <label for="city-search" class="block text-sm font-medium text-neutral-800">Search U.S. cities</label>
              <p class="mt-1 text-xs leading-5 text-neutral-500">
                Start typing and choose a Google Places city result. Add as many cities as you want for this sweep.
              </p>
              <input id="city-search" type="search" autocomplete="off" placeholder="Austin, TX" class="mt-3 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm" />
              <div id="city-search-results" class="absolute left-4 right-4 z-20 mt-1 hidden overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-lg"></div>
              <div id="city-selections" class="mt-3 flex flex-wrap gap-2"></div>
              <div class="mt-2 flex justify-end">
                <img src="https://maps.gstatic.com/mapfiles/api-3/images/powered-by-google-on-white3.png" alt="Powered by Google" class="h-4 w-auto" loading="lazy" />
              </div>
            </div>
          </div>

          <div class="rounded-xl bg-neutral-50 p-4">
            <div class="grid gap-4 sm:grid-cols-3">
              <div>
                <p class="text-xs uppercase tracking-wider text-neutral-500">Scope</p>
                <p id="scope-summary" class="mt-1 text-sm font-medium text-neutral-900">0 verticals × 0 cities</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-neutral-500">Base search requests</p>
                <p id="base-query-count" class="mt-1 text-sm font-medium text-neutral-900">0</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-neutral-500">Max with pagination</p>
                <p id="max-query-count" class="mt-1 text-sm font-medium text-neutral-900">0</p>
              </div>
            </div>
          </div>

          <label class="flex items-center gap-3 rounded-lg border border-neutral-200 p-3">
            <input id="merge" type="checkbox" checked />
            <span class="text-sm text-neutral-700">Merge prior discovery coverage</span>
          </label>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="crawl-batch" class="block text-sm font-medium text-neutral-800">Crawl batch</label>
              <input id="crawl-batch" type="number" min="1" max="500" value="80" class="mt-2 w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm" />
            </div>
            <div>
              <label for="psi-batch" class="block text-sm font-medium text-neutral-800">PageSpeed batch</label>
              <input id="psi-batch" type="number" min="1" max="200" value="20" class="mt-2 w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm" />
            </div>
          </div>

          <div id="form-message" class="hidden rounded-lg border p-3 text-sm"></div>

          <button id="start-button" type="submit" disabled class="rounded-lg bg-neutral-950 px-5 py-2.5 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">
            Start sweep
          </button>
        </form>
      </section>

      <div class="space-y-6">
        <section class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-lg font-semibold text-neutral-950">Current sweep</h2>
            <button id="refresh-button" type="button" class="text-sm font-medium text-neutral-600 hover:text-neutral-950">Refresh</button>
          </div>
          <div id="current-job" class="mt-6"><p class="text-sm text-neutral-500">Loading…</p></div>
        </section>

        <section class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
          <div>
            <h2 class="text-lg font-semibold text-neutral-950">Recent sweeps</h2>
            <p class="mt-1 text-sm text-neutral-500">Completed and failed jobs stay visible here.</p>
          </div>
          <div id="recent-jobs" class="mt-5 space-y-3"><p class="text-sm text-neutral-500">Loading…</p></div>
        </section>
      </div>
    </div>
  </main>

  <script>
    type VerticalConfig = {
      key: string;
      priority: number;
      query_count: number;
      has_case_study: boolean;
    };

    type MarketConfig = {
      geo_scope: string;
      verticals: VerticalConfig[];
      execution_enabled: boolean;
    };

    type CitySuggestion = {
      place_id: string;
      label: string;
    };

    type SweepJob = {
      id: string;
      run_id?: string | null;
      status: string;
      stage: string | null;
      verticals: string[];
      cities: string[] | null;
      use_grid: boolean;
      crawl_batch: number;
      psi_batch: number;
      created_at?: string;
      started_at?: string | null;
      finished_at?: string | null;
      error_message?: string | null;
    };

    const required = <T extends HTMLElement>(selector: string): T => {
      const element = document.querySelector<T>(selector);
      if (!element) throw new Error(`Missing required element: ${selector}`);
      return element;
    };

    const form = required<HTMLFormElement>("#sweep-form");
    const startButton = required<HTMLButtonElement>("#start-button");
    const warning = required<HTMLElement>("#execution-warning");
    const currentJob = required<HTMLElement>("#current-job");
    const recentJobs = required<HTMLElement>("#recent-jobs");
    const message = required<HTMLElement>("#form-message");
    const refreshButton = required<HTMLButtonElement>("#refresh-button");
    const verticalOptions = required<HTMLElement>("#vertical-options");
    const customVerticalsInput = required<HTMLTextAreaElement>("#custom-verticals");
    const citySearchInput = required<HTMLInputElement>("#city-search");
    const citySearchResults = required<HTMLElement>("#city-search-results");
    const citySelections = required<HTMLElement>("#city-selections");
    const mergeInput = required<HTMLInputElement>("#merge");
    const crawlBatchInput = required<HTMLInputElement>("#crawl-batch");
    const psiBatchInput = required<HTMLInputElement>("#psi-batch");

    let marketConfig: MarketConfig | null = null;
    let selectedCities: string[] = [];
    let citySearchTimer: number | null = null;
    let citySearchController: AbortController | null = null;

    const escapeHtml = (value: unknown): string =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const normalizeVertical = (value: string): string =>
      value
        .trim()
        .toLowerCase()
        .replaceAll("&", " and ")
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/_+/g, "_")
        .replace(/^_+|_+$/g, "");

    const presetVerticals = (): string[] =>
      Array.from(document.querySelectorAll<HTMLInputElement>('input[data-vertical]:checked'))
        .map((input) => input.value);

    const customVerticals = (): string[] =>
      customVerticalsInput.value
        .split(/[\n,]+/)
        .map(normalizeVertical)
        .filter(Boolean);

    const checkedVerticals = (): string[] =>
      Array.from(new Set([...presetVerticals(), ...customVerticals()]));

    function renderSelectedCities(): void {
      citySelections.innerHTML = selectedCities
        .map((city) => `
          <span class="inline-flex items-center gap-2 rounded-full border border-neutral-300 bg-white px-3 py-1.5 text-xs font-medium text-neutral-800">
            ${escapeHtml(city)}
            <button type="button" data-remove-city="${escapeHtml(city)}" aria-label="Remove ${escapeHtml(city)}" class="text-neutral-400 hover:text-neutral-900">×</button>
          </span>
        `)
        .join("");

      document.querySelectorAll<HTMLButtonElement>("[data-remove-city]")
        .forEach((button) => button.addEventListener("click", () => {
          const city = button.dataset.removeCity;
          if (!city) return;
          selectedCities = selectedCities.filter((item) => item !== city);
          renderSelectedCities();
          updateScopeSummary();
        }));
    }

    function selectCity(label: string): void {
      if (!selectedCities.includes(label)) selectedCities.push(label);
      renderSelectedCities();
      citySearchInput.value = "";
      citySearchResults.classList.add("hidden");
      citySearchResults.innerHTML = "";
      updateScopeSummary();
    }

    function renderCitySuggestions(items: CitySuggestion[]): void {
      if (!items.length) {
        citySearchResults.innerHTML = '<div class="px-3 py-2 text-xs text-neutral-500">No city matches.</div>';
        citySearchResults.classList.remove("hidden");
        return;
      }

      citySearchResults.innerHTML = items
        .map((item) => `
          <button type="button" data-city-suggestion="${escapeHtml(item.label)}" class="block w-full border-b border-neutral-100 px-3 py-2 text-left text-sm text-neutral-800 last:border-0 hover:bg-neutral-50">
            ${escapeHtml(item.label)}
          </button>
        `)
        .join("");
      citySearchResults.classList.remove("hidden");

      document.querySelectorAll<HTMLButtonElement>("[data-city-suggestion]")
        .forEach((button) => button.addEventListener("click", () => {
          const label = button.dataset.citySuggestion;
          if (label) selectCity(label);
        }));
    }

    async function searchCities(query: string): Promise<void> {
      citySearchController?.abort();
      citySearchController = new AbortController();
      try {
        const response = await fetch(`/api/sweeps/locations?q=${encodeURIComponent(query)}`, {
          signal: citySearchController.signal,
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.detail || "Unable to search cities.");
        renderCitySuggestions((body.items || []) as CitySuggestion[]);
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        citySearchResults.innerHTML = `<div class="px-3 py-2 text-xs text-red-700">${escapeHtml(error instanceof Error ? error.message : "Unable to search cities.")}</div>`;
        citySearchResults.classList.remove("hidden");
      }
    }

    function renderMarketConfig(config: MarketConfig): void {
      required<HTMLElement>("#market-vertical-count").textContent = String(config.verticals.length);

      verticalOptions.innerHTML = config.verticals
        .map((vertical) => `
          <label class="flex items-center gap-2 rounded-lg border border-neutral-200 p-3 text-sm text-neutral-800">
            <input data-vertical type="checkbox" value="${escapeHtml(vertical.key)}" />
            <span>
              <span class="font-medium">${escapeHtml(vertical.key.replaceAll("_", " "))}</span>
              ${vertical.has_case_study ? '<span class="ml-1 text-xs text-neutral-500">case study</span>' : ''}
            </span>
          </label>
        `)
        .join("");

      document.querySelectorAll<HTMLInputElement>('input[data-vertical]')
        .forEach((input) => input.addEventListener("change", updateScopeSummary));

      warning.classList.toggle("hidden", config.execution_enabled);
      updateScopeSummary();
      updateStartButton();
    }

    function updateScopeSummary(): void {
      if (!marketConfig) return;

      const verticals = checkedVerticals();
      const presets = presetVerticals();
      const customs = customVerticals().filter((vertical) => !presets.includes(vertical));
      const presetQueryCount = marketConfig.verticals
        .filter((vertical) => presets.includes(vertical.key))
        .reduce((sum, vertical) => sum + vertical.query_count, 0);
      const queryCount = presetQueryCount + customs.length;
      const baseRequests = queryCount * selectedCities.length;

      required<HTMLElement>("#vertical-selection-count").textContent = `${verticals.length} selected (${presets.length} preset, ${customs.length} custom)`;
      required<HTMLElement>("#scope-summary").textContent = `${verticals.length} verticals × ${selectedCities.length} cities`;
      required<HTMLElement>("#base-query-count").textContent = baseRequests.toLocaleString();
      required<HTMLElement>("#max-query-count").textContent = (baseRequests * 3).toLocaleString();

      updateStartButton();
    }

    function updateStartButton(): void {
      const hasScope = Boolean(marketConfig && checkedVerticals().length);
      const hasCities = selectedCities.length > 0;
      const activeJob = currentJob.dataset.active === "true";
      startButton.disabled = !marketConfig?.execution_enabled || !hasScope || !hasCities || activeJob;
    }

    async function cancelJob(id: string): Promise<void> {
      const response = await fetch(`/api/sweeps/${encodeURIComponent(id)}/cancel`, { method: "POST" });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        window.alert(body.detail || "Unable to cancel sweep.");
      }
      await refreshState();
    }

    function cityLabel(job: SweepJob): string {
      return job.cities?.length ? job.cities.join(", ") : "Legacy configured-market sweep";
    }

    function renderCurrent(job: SweepJob | null): void {
      currentJob.dataset.active = job ? "true" : "false";

      if (!job) {
        currentJob.innerHTML = `
          <div class="rounded-xl bg-neutral-50 p-5">
            <p class="text-sm font-medium text-neutral-900">No active sweep</p>
            <p class="mt-1 text-sm text-neutral-500">The worker is idle. Recent outcomes remain below.</p>
          </div>
        `;
        updateStartButton();
        return;
      }

      currentJob.innerHTML = `
        <div class="space-y-4 rounded-xl bg-neutral-50 p-5">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-wider text-neutral-500">Status</p>
              <p class="mt-1 text-lg font-semibold text-neutral-950">${escapeHtml(job.status)}</p>
            </div>
            <span class="rounded-full bg-white px-2.5 py-1 text-xs text-neutral-600">${escapeHtml(job.stage || "queued")}</span>
          </div>
          <div class="space-y-2 text-sm">
            <p><span class="text-neutral-500">Verticals:</span> <span class="font-medium">${escapeHtml(job.verticals.join(", "))}</span></p>
            <p><span class="text-neutral-500">Cities:</span> <span class="font-medium">${escapeHtml(cityLabel(job))}</span></p>
          </div>
          <button id="cancel-active-job" type="button" class="rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50">Stop sweep</button>
        </div>
      `;

      document.querySelector<HTMLButtonElement>("#cancel-active-job")
        ?.addEventListener("click", () => cancelJob(job.id));
      updateStartButton();
    }

    function formatDate(value: string | null | undefined): string {
      if (!value) return "—";
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : date.toLocaleString();
    }

    function renderHistory(items: SweepJob[]): void {
      if (!items.length) {
        recentJobs.innerHTML = '<p class="text-sm text-neutral-500">No sweep history yet.</p>';
        return;
      }

      recentJobs.innerHTML = items.slice(0, 8).map((job) => {
        const statusClass = job.status === "completed"
          ? "bg-emerald-50 text-emerald-800"
          : job.status === "failed"
            ? "bg-red-50 text-red-700"
            : "bg-neutral-100 text-neutral-700";

        return `
          <div class="rounded-xl border border-neutral-200 p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-sm font-medium text-neutral-950">${escapeHtml(job.verticals.join(", ").replaceAll("_", " "))}</p>
                <p class="mt-1 text-xs text-neutral-500">${escapeHtml(cityLabel(job))}</p>
              </div>
              <span class="rounded-full px-2.5 py-1 text-xs font-medium ${statusClass}">${escapeHtml(job.status)}</span>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2 text-xs text-neutral-500">
              <span>Created ${escapeHtml(formatDate(job.created_at))}</span>
              <span>Stage ${escapeHtml(job.stage || "—")}</span>
            </div>
            ${job.error_message ? `<p class="mt-3 text-xs leading-5 text-red-700">${escapeHtml(job.error_message)}</p>` : ""}
          </div>
        `;
      }).join("");
    }

    async function loadConfig(): Promise<void> {
      const response = await fetch("/api/sweeps/config");
      if (!response.ok) throw new Error("Unable to load sweep configuration.");
      marketConfig = await response.json();
      renderMarketConfig(marketConfig as MarketConfig);
    }

    async function refreshState(): Promise<void> {
      const [currentResponse, historyResponse] = await Promise.all([
        fetch("/api/sweeps/current"),
        fetch("/api/sweeps?limit=8"),
      ]);

      if (currentResponse.ok) {
        const data = await currentResponse.json();
        warning.classList.toggle("hidden", Boolean(data.execution_enabled));
        renderCurrent(data.job || null);
      } else {
        currentJob.innerHTML = '<p class="text-sm text-red-700">Unable to load sweep state.</p>';
      }

      if (historyResponse.ok) {
        const data = await historyResponse.json();
        renderHistory(data.items || []);
      } else {
        recentJobs.innerHTML = '<p class="text-sm text-red-700">Unable to load sweep history.</p>';
      }
    }

    form.addEventListener("submit", async (event: SubmitEvent) => {
      event.preventDefault();
      if (!marketConfig) return;

      const verticals = checkedVerticals();
      const cities = [...selectedCities];

      if (!verticals.length || !cities.length) {
        message.textContent = "Select at least one vertical and one U.S. city.";
        message.className = "rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800";
        return;
      }

      const confirmed = window.confirm(
        `Start sweep for ${verticals.length} vertical(s) across ${cities.length} city target(s)?`,
      );
      if (!confirmed) return;

      message.classList.add("hidden");
      startButton.disabled = true;

      const response = await fetch("/api/sweeps", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          verticals,
          cities,
          use_grid: false,
          merge_results: mergeInput.checked,
          crawl_batch: Number(crawlBatchInput.value),
          psi_batch: Number(psiBatchInput.value),
        }),
      });

      const body = await response.json().catch(() => ({}));

      if (!response.ok) {
        message.textContent = body.detail || "Unable to start sweep.";
        message.className = "rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800";
        updateStartButton();
        return;
      }

      message.textContent = "Sweep queued.";
      message.className = "rounded-lg border border-emerald-300 bg-emerald-50 p-3 text-sm text-emerald-800";
      await refreshState();
    });

    customVerticalsInput.addEventListener("input", updateScopeSummary);
    citySearchInput.addEventListener("input", () => {
      const query = citySearchInput.value.trim();
      if (citySearchTimer !== null) window.clearTimeout(citySearchTimer);
      if (query.length < 2) {
        citySearchController?.abort();
        citySearchResults.classList.add("hidden");
        citySearchResults.innerHTML = "";
        return;
      }
      citySearchTimer = window.setTimeout(() => void searchCities(query), 250);
    });
    citySearchInput.addEventListener("blur", () => {
      window.setTimeout(() => citySearchResults.classList.add("hidden"), 150);
    });
    citySearchInput.addEventListener("focus", () => {
      if (citySearchResults.innerHTML) citySearchResults.classList.remove("hidden");
    });
    refreshButton.addEventListener("click", () => void refreshState());

    void (async () => {
      try {
        await loadConfig();
        await refreshState();
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : "Unable to initialize sweep workspace.";
        message.className = "rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800";
      }
    })();

    window.setInterval(() => void refreshState(), 5000);
  </script>
</AppLayout>
