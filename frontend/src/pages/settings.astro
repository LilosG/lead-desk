---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout
  title="Settings"
  description="Lead Desk integrations and application configuration."
>
  <section class="space-y-5">
    <div class="rounded-xl border border-[var(--line)] bg-white p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--muted)]">Google Workspace</p>
          <h2 class="mt-2 text-xl font-semibold text-[var(--ink)]">Gmail drafts</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">
            Connect mike@lilosgrowth.com so reviewed outreach can be created as Gmail drafts. Lead Desk has no email send endpoint.
          </p>
        </div>
        <span id="gmail-pill" class="inline-flex w-fit rounded-full border border-[var(--line)] px-3 py-1 text-xs font-medium text-[var(--muted)]">
          Checking…
        </span>
      </div>

      <div class="mt-6 grid gap-4 rounded-lg border border-[var(--line)] bg-[var(--canvas)] p-4 sm:grid-cols-2">
        <div>
          <p class="text-xs uppercase tracking-[0.14em] text-[var(--muted)]">Account</p>
          <p id="gmail-account" class="mt-1 text-sm font-medium text-[var(--ink)]">—</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.14em] text-[var(--muted)]">Permission</p>
          <p class="mt-1 text-sm font-medium text-[var(--ink)]">Create/manage Gmail drafts</p>
        </div>
      </div>

      <div id="gmail-message" class="mt-4 hidden rounded-lg border border-[var(--line)] px-4 py-3 text-sm"></div>

      <div class="mt-5 flex flex-wrap gap-3">
        <button id="gmail-connect" type="button" class="rounded-lg bg-[var(--ink)] px-4 py-2 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-50">
          Connect Gmail
        </button>
        <button id="gmail-disconnect" type="button" class="hidden rounded-lg border border-[var(--line)] bg-white px-4 py-2 text-sm font-medium text-[var(--ink)]">
          Disconnect
        </button>
      </div>
    </div>

    <div class="rounded-xl border border-[var(--line)] bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--muted)]">Outreach safety</p>
      <h2 class="mt-2 text-xl font-semibold text-[var(--ink)]">Do not contact list</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-[var(--muted)]">
        Emails on this list are never drafted or sent to, in any campaign. Adding one also closes any open outreach already queued for that address.
      </p>

      <form id="dnc-form" class="mt-5 flex flex-col gap-3 sm:flex-row">
        <input id="dnc-email" type="email" required placeholder="name@company.com" class="w-full rounded-lg border border-[var(--line)] px-3 py-2 text-sm sm:max-w-xs" />
        <input id="dnc-reason" type="text" placeholder="Reason (optional)" class="w-full rounded-lg border border-[var(--line)] px-3 py-2 text-sm sm:max-w-xs" />
        <button type="submit" class="rounded-lg bg-[var(--ink)] px-4 py-2 text-sm font-medium text-white">Add to list</button>
      </form>

      <div id="dnc-message" class="mt-4 hidden rounded-lg border border-[var(--line)] px-4 py-3 text-sm"></div>
      <ul id="dnc-list" class="mt-4 divide-y divide-[var(--line)] text-sm"></ul>
    </div>
  </section>

  <script>
    type Suppressed = { email: string; reason: string | null; added_at: string };

    const dncForm = document.getElementById('dnc-form') as HTMLFormElement | null;
    const dncEmail = document.getElementById('dnc-email') as HTMLInputElement | null;
    const dncReason = document.getElementById('dnc-reason') as HTMLInputElement | null;
    const dncList = document.getElementById('dnc-list');
    const dncMessage = document.getElementById('dnc-message');

    function dncShow(text: string, isError = false): void {
      if (!dncMessage) return;
      dncMessage.textContent = text;
      dncMessage.classList.remove('hidden');
      dncMessage.classList.toggle('text-red-700', isError);
    }

    async function dncLoad(): Promise<void> {
      const response = await fetch('/api/suppression', { credentials: 'same-origin' });
      if (!response.ok) throw new Error('Could not load the do not contact list.');
      const rows = await response.json() as Suppressed[];
      if (!dncList) return;
      dncList.replaceChildren();
      if (rows.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'py-3 text-[var(--muted)]';
        empty.textContent = 'No one on the list yet.';
        dncList.append(empty);
        return;
      }
      for (const row of rows) {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-4 py-3';
        const info = document.createElement('div');
        const email = document.createElement('p');
        email.className = 'font-medium text-[var(--ink)]';
        email.textContent = row.email;
        const meta = document.createElement('p');
        meta.className = 'text-xs text-[var(--muted)]';
        meta.textContent = `${row.reason || 'do not contact'} · ${new Date(row.added_at).toLocaleDateString()}`;
        info.append(email, meta);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'text-xs font-medium text-red-700';
        remove.textContent = 'Remove';
        remove.addEventListener('click', async () => {
          if (!window.confirm(`Remove ${row.email}? They could be emailed again.`)) return;
          const res = await fetch(`/api/suppression/${encodeURIComponent(row.email)}`, {
            method: 'DELETE',
            credentials: 'same-origin',
          });
          if (!res.ok) { dncShow('Could not remove that address.', true); return; }
          dncLoad().catch(() => undefined);
        });
        li.append(info, remove);
        dncList.append(li);
      }
    }

    dncForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const response = await fetch('/api/suppression', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: dncEmail?.value ?? '', reason: dncReason?.value ?? '' }),
      });
      const data = await response.json().catch(() => ({})) as { email?: string; detail?: string };
      if (!response.ok) { dncShow(data.detail || 'Could not add that address.', true); return; }
      dncShow(`${data.email} will never be contacted.`);
      dncForm.reset();
      dncLoad().catch(() => undefined);
    });

    dncLoad().catch((error: unknown) => {
      dncShow(error instanceof Error ? error.message : 'Could not load the do not contact list.', true);
    });
  </script>

  <script>
    type GmailStatus = {
      configured: boolean;
      connected: boolean;
      account_email: string | null;
      sender_email: string;
    };

    const pill = document.getElementById('gmail-pill');
    const account = document.getElementById('gmail-account');
    const connect = document.getElementById('gmail-connect') as HTMLButtonElement | null;
    const disconnect = document.getElementById('gmail-disconnect') as HTMLButtonElement | null;
    const message = document.getElementById('gmail-message');

    function showMessage(text: string, isError = false): void {
      if (!message) return;
      message.textContent = text;
      message.classList.remove('hidden');
      message.classList.toggle('text-red-700', isError);
    }

    async function loadStatus(): Promise<void> {
      const response = await fetch('/api/integrations/gmail/status', { credentials: 'same-origin' });
      if (!response.ok) throw new Error('Could not load Gmail integration status.');
      const data = await response.json() as GmailStatus;

      if (pill) pill.textContent = data.connected ? 'Connected' : (data.configured ? 'Ready to connect' : 'Configuration required');
      if (account) account.textContent = data.account_email || data.sender_email || '—';
      if (connect) {
        connect.classList.toggle('hidden', data.connected);
        connect.toggleAttribute('disabled', !data.configured);
      }
      if (disconnect) disconnect.classList.toggle('hidden', !data.connected);

      if (!data.configured) {
        showMessage('The server-side Google OAuth client configuration is not complete yet.', true);
      }
    }

    connect?.addEventListener('click', async () => {
      connect.setAttribute('disabled', '');
      try {
        const response = await fetch('/api/integrations/gmail/connect', {
          method: 'POST',
          credentials: 'same-origin',
        });
        const data = await response.json() as { authorization_url?: string; detail?: string };
        if (!response.ok || !data.authorization_url) {
          throw new Error(data.detail || 'Could not start Gmail authorization.');
        }
        window.location.assign(data.authorization_url);
      } catch (error: unknown) {
        showMessage(error instanceof Error ? error.message : 'Could not start Gmail authorization.', true);
        connect.removeAttribute('disabled');
      }
    });

    disconnect?.addEventListener('click', async () => {
      if (!window.confirm('Disconnect Gmail from Lead Desk? Existing Gmail drafts will not be deleted.')) return;
      const response = await fetch('/api/integrations/gmail', {
        method: 'DELETE',
        credentials: 'same-origin',
      });
      if (!response.ok) {
        showMessage('Could not disconnect Gmail.', true);
        return;
      }
      window.location.reload();
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get('gmail') === 'connected') {
      showMessage('Gmail connected successfully.');
      history.replaceState({}, '', '/settings');
    } else if (params.get('gmail') === 'error' && params.get('reason') === 'missing_permission') {
      showMessage('Gmail was not connected: Google\'s screen had the Gmail permission unticked. Click Connect Gmail again and tick "Manage drafts and send emails" (or click "Select all") before Continue.', true);
      history.replaceState({}, '', '/settings');
    } else if (params.get('gmail') === 'error') {
      const reason = params.get('reason');
      const detail = params.get('detail');
      const why = reason === 'denied'
        ? 'Google sign-in was cancelled or denied'
        : reason === 'invalid_callback'
          ? 'Google sent back an incomplete response'
          : 'Gmail authorization did not complete';
      showMessage(`${why}${detail ? `: ${detail}` : '.'} Try Connect Gmail again.`, true);
      history.replaceState({}, '', '/settings');
    }

    loadStatus().catch((error: unknown) => {
      showMessage(error instanceof Error ? error.message : 'Could not load Gmail integration status.', true);
    });
  </script>
</AppLayout>
