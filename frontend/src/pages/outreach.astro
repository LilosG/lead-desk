---
import AppLayout from '../layouts/AppLayout.astro';

const stages = [
  { key: 'to_prep', label: 'To prep', hint: 'Has an email, not started' },
  { key: 'verify', label: 'Check site', hint: 'Site blocked our crawler' },
  { key: 'call', label: 'Call list', hint: 'No email yet' },
  { key: 'review', label: 'In review', hint: 'Draft being worked on' },
  { key: 'attention', label: 'Needs attention', hint: 'Stopped, see why' },
  { key: 'in_gmail', label: 'In Gmail', hint: 'Draft waiting to send' },
  { key: 'contacted', label: 'Contacted', hint: 'Sent, awaiting reply' },
  { key: 'replied', label: 'Replied', hint: 'They answered' },
  { key: 'closed', label: 'Closed', hint: 'Archived' },
];
---

<AppLayout
  title="Outreach"
  description="Every prospect, in one stage, with the next step. Nothing is sent from here."
>
  <div class="space-y-4">
    <section class="rounded-lg border border-[var(--line)] bg-white px-4 py-3">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <div id="campaign-tabs" role="group" aria-label="Campaign" class="flex flex-wrap gap-2"></div>
        <p id="campaign-summary" class="text-xs text-[var(--muted)]"></p>
      </div>
      <details id="campaign-results" class="mt-2 text-xs">
        <summary class="cursor-pointer font-medium text-[var(--muted)]">Results by market and niche</summary>
        <div id="campaign-results-body" class="mt-2 overflow-x-auto"></div>
      </details>
    </section>

    <nav id="stage-tabs" aria-label="Outreach stages" class="grid grid-cols-3 gap-2 sm:grid-cols-5 xl:grid-cols-9">
      {stages.map((stage) => (
        <button
          type="button"
          data-stage={stage.key}
          class="rounded-lg border border-[var(--line)] bg-white px-3 py-2.5 text-left transition hover:border-[var(--accent)]"
        >
          <span class="block text-[11px] font-semibold text-[var(--muted)]">{stage.label}</span>
          <span data-count={stage.key} class="mt-0.5 block text-xl font-semibold">—</span>
          <span class="mt-0.5 hidden text-[10px] leading-3 text-[var(--muted)] xl:block">{stage.hint}</span>
        </button>
      ))}
    </nav>

    <section class="flex flex-wrap items-end gap-3 rounded-lg border border-[var(--line)] bg-white px-4 py-3">
      <div class="min-w-[220px] flex-1">
        <label for="filter-q" class="mb-1 block text-[11px] font-medium text-[var(--muted)]">Find a prospect</label>
        <input id="filter-q" type="search" placeholder="Name, city, email or phone" class="w-full rounded-md border border-[var(--line)] px-3 py-1.5 text-sm" />
      </div>
      <div>
        <label for="filter-vertical" class="mb-1 block text-[11px] font-medium text-[var(--muted)]">Niche</label>
        <select id="filter-vertical" class="rounded-md border border-[var(--line)] bg-white px-2 py-1.5 text-sm"><option value="">All niches</option></select>
      </div>
      <div>
        <label for="filter-market" class="mb-1 block text-[11px] font-medium text-[var(--muted)]">Market</label>
        <select id="filter-market" class="rounded-md border border-[var(--line)] bg-white px-2 py-1.5 text-sm"><option value="">All markets</option></select>
      </div>
      <label id="qualified-option" class="flex items-center gap-2 pb-1.5 text-sm"><input id="filter-qualified" type="checkbox" /> Qualified only</label>
      <div class="ml-auto flex items-center gap-3 pb-1 text-xs text-[var(--muted)]">
        <span id="gmail-status">Gmail —</span>
        <button id="sync-gmail" type="button" class="rounded-md border border-[var(--line)] px-3 py-1.5 font-medium text-[var(--ink)] disabled:cursor-not-allowed disabled:opacity-40">Check Gmail</button>
      </div>
    </section>

    <div id="page-error" class="hidden rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>
    <div id="page-note" class="hidden rounded-lg border border-[var(--line)] bg-white px-4 py-3 text-sm"></div>

    <section class="overflow-hidden rounded-lg border border-[var(--line)] bg-white">
      <div class="flex flex-wrap items-center gap-3 border-b border-[var(--line)] bg-[var(--surface-muted)] px-4 py-2.5 text-xs">
        <label class="flex items-center gap-2"><input id="select-all" type="checkbox" /> Select all</label>
        <span id="selected-count" class="text-[var(--muted)]">0 selected</span>
        <div class="ml-auto flex flex-wrap items-center gap-2">
          <button id="bulk-prep" type="button" class="hidden rounded-md bg-[var(--dark)] px-3 py-1.5 font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">Audit + email + Gmail draft</button>
          <div id="bulk-status-group" class="hidden items-center gap-2">
            <select id="bulk-status" class="rounded-md border border-[var(--line)] bg-white px-2 py-1.5">
              <option value="contacted">Contacted</option>
              <option value="replied">Replied</option>
              <option value="archived">Archived</option>
            </select>
            <button id="bulk-apply" type="button" class="rounded-md bg-[var(--dark)] px-3 py-1.5 font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">Set status</button>
          </div>
        </div>
      </div>
      <div id="bulk-result" class="hidden border-b border-[var(--line)] px-4 py-3 text-xs leading-5"></div>

      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-[var(--line)] text-left text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--muted)]">
              <th class="w-8 px-4 py-2.5"></th>
              <th class="px-3 py-2.5">Prospect</th>
              <th class="px-3 py-2.5">Contact</th>
              <th class="px-3 py-2.5">Score</th>
              <th class="px-3 py-2.5">Next step</th>
              <th id="when-heading" class="px-3 py-2.5">Updated</th>
              <th class="px-4 py-2.5"></th>
            </tr>
          </thead>
          <tbody id="rows" class="divide-y divide-[var(--line)]"></tbody>
        </table>
      </div>
      <div id="empty" class="hidden px-6 py-12 text-center text-sm text-[var(--muted)]">Nothing here with these filters.</div>
      <div class="flex items-center justify-between border-t border-[var(--line)] px-4 py-2.5">
        <div id="page-label" class="text-xs text-[var(--muted)]"></div>
        <div class="flex gap-2">
          <button id="prev" type="button" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40">Previous</button>
          <button id="next" type="button" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40">Next</button>
        </div>
      </div>
    </section>
  </div>

  <div id="drawer-scrim" class="fixed inset-0 z-40 hidden bg-black/30"></div>
  <aside id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-name" class="fixed inset-y-0 right-0 z-50 hidden w-full max-w-xl overflow-y-auto bg-white shadow-2xl">
    <div class="sticky top-0 flex items-start justify-between gap-4 border-b border-[var(--line)] bg-white px-5 py-4">
      <div class="min-w-0">
        <a id="drawer-name" class="block truncate text-base font-semibold hover:underline" href="#"></a>
        <div id="drawer-next" class="mt-0.5 text-xs text-[var(--muted)]"></div>
      </div>
      <button id="drawer-close" type="button" aria-label="Close" class="rounded-md border border-[var(--line)] px-2.5 py-1 text-sm">✕</button>
    </div>

    <div class="space-y-4 p-5">
      <div class="grid gap-2 sm:grid-cols-2">
        <button id="draft-generate" type="button" class="rounded-md border border-[var(--line)] px-4 py-2.5 text-sm font-medium disabled:cursor-not-allowed disabled:opacity-40">Generate draft</button>
        <button id="draft-gmail" type="button" class="rounded-md bg-[var(--dark)] px-4 py-2.5 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">Create Gmail draft</button>
      </div>
      <a id="draft-open-gmail" target="_blank" rel="noreferrer" class="hidden rounded-md border border-[var(--line)] px-4 py-2.5 text-center text-sm font-medium">Open in Gmail</a>
      <p id="draft-reason" class="hidden rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900"></p>

      <form id="draft-form" class="space-y-3">
        <input id="draft-id" type="hidden" />
        <input id="draft-version" type="hidden" />
        <div>
          <label for="draft-to" class="mb-1 block text-xs font-medium text-[var(--muted)]">To</label>
          <input id="draft-to" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="draft-subject" class="mb-1 block text-xs font-medium text-[var(--muted)]">Subject</label>
          <input id="draft-subject" maxlength="300" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="draft-body" class="mb-1 block text-xs font-medium text-[var(--muted)]">Email</label>
          <textarea id="draft-body" rows="14" maxlength="20000" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm"></textarea>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label for="draft-status" class="mb-1 block text-xs font-medium text-[var(--muted)]">Status</label>
            <select id="draft-status" class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm">
              <option value="queued">Queued</option>
              <option value="researching">Researching</option>
              <option value="review_required">In review</option>
              <option value="no_outreach_finding">No finding</option>
              <option value="draft_ready">Draft ready</option>
              <option value="approved">Approved</option>
              <option value="contacted">Contacted</option>
              <option value="replied">Replied</option>
              <option value="archived">Archived</option>
              <option value="suppressed" disabled>Do not contact</option>
            </select>
          </div>
          <div>
            <label for="draft-verification" class="mb-1 block text-xs font-medium text-[var(--muted)]">Claim check</label>
            <select id="draft-verification" class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm">
              <option value="pending">Pending</option>
              <option value="verified">Verified</option>
              <option value="failed">Failed</option>
              <option value="not_required">Not required</option>
            </select>
          </div>
        </div>
        <div id="draft-meta" class="text-xs leading-5 text-[var(--muted)]"></div>
        <div id="draft-error" class="hidden rounded-md border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700"></div>
        <button type="submit" class="w-full rounded-md border border-[var(--line)] px-4 py-2.5 text-sm font-medium">Save changes</button>
      </form>
      <button id="draft-stop" type="button" class="w-full rounded-md border border-red-200 px-4 py-2.5 text-sm font-medium text-red-700 disabled:cursor-not-allowed disabled:opacity-40">Do not contact</button>
    </div>
  </aside>

  <script>
    type Row = {
      kind: 'queue' | 'candidate';
      id: string | null;
      place_id: string;
      stage: string;
      status: string | null;
      channel: string | null;
      email: string | null;
      phone: string | null;
      name: string | null;
      city: string | null;
      vertical: string | null;
      tier: string | null;
      total_score: number | null;
      fit_score: number | null;
      qualification: string | null;
      headline_gap: string | null;
      gmail_draft_created_at: string | null;
      gmail_message_id: string | null;
      gmail_draft_left_at: string | null;
      contacted_at: string | null;
      cooldown_until: string | null;
      updated_at: string;
      next_step: string;
    };

    type Campaign = {
      key: string;
      name: string;
      description: string;
      sent: number;
      replied: number;
      opted_out: number;
      reply_rate: number | null;
      prep_label: string;
      uses_audit: boolean;
    };

    type CampaignResult = {
      market: string;
      vertical: string;
      sent: number;
      replied: number;
      reply_rate: number;
    };

    type Board = {
      counts: Record<string, number>;
      items: Row[];
      pagination: { page: number; page_size: number; total: number; total_pages: number };
      filters: { verticals: string[]; markets: string[] };
    };

    type Item = {
      id: string;
      place_id: string;
      name: string | null;
      city: string | null;
      channel: string;
      stage: string;
      status: string;
      to_address: string | null;
      subject: string | null;
      body: string | null;
      verification_status: string;
      verification_note: string | null;
      generation_model: string | null;
      draft_generated_at: string | null;
      gmail_draft_id: string | null;
      gmail_message_id: string | null;
      gmail_draft_created_at: string | null;
      gmail_draft_left_at: string | null;
      contacted_at: string | null;
      version: number;
      next_step: string;
      gmail_block_reason: string | null;
    };

    const SYNC_KEY = 'outreach-last-gmail-sync';
    const SYNC_EVERY_MS = 120_000;
    const PREP_STAGES = new Set(['to_prep', 'review', 'attention']);
    const STATUS_STAGES = new Set(['review', 'attention', 'in_gmail', 'contacted', 'replied', 'call']);
    const STEP_LABELS: Record<string, string> = {
      cooldown: 'cooldown', audit: 'audit', queue: 'queue', draft: 'email draft', ready: 'draft ready', gmail_draft: 'Gmail draft',
    };

    const el = <T extends HTMLElement>(selector: string): T => {
      const node = document.querySelector<T>(selector);
      if (!node) throw new Error(`Missing ${selector}`);
      return node;
    };

    const esc = (value: unknown): string => String(value ?? '')
      .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;').replaceAll("'", '&#039;');

    const shortDate = (value: string | null): string =>
      value ? new Date(value).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) : '—';

    const gmailDraftUrl = (messageId: string | null): string =>
      messageId ? `https://mail.google.com/mail/u/0/#drafts?compose=${encodeURIComponent(messageId)}` : 'https://mail.google.com/mail/u/0/#drafts';

    async function api(path: string, init?: RequestInit) {
      const response = await fetch(path, {
        ...init,
        headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...(init?.headers || {}) },
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.detail || `API returned ${response.status}`);
      return body;
    }

    const params = new URLSearchParams(window.location.search);
    const state = {
      campaign: params.get('campaign') || 'seo_websites',
      stage: params.get('stage') || 'to_prep',
      q: params.get('q') || '',
      vertical: params.get('vertical') || '',
      market: params.get('market') || '',
      qualifiedOnly: params.has('qualified') ? params.get('qualified') === 'true' : true,
      page: Math.max(1, Number(params.get('page') || 1)),
    };
    let rows: Row[] = [];
    let campaigns: Campaign[] = [];
    const selected = new Set<string>();
    let gmailConnected = false;
    let searchTimer: number | undefined;

    const rowKey = (row: Row): string => row.id || row.place_id;
    const currentCampaign = (): Campaign | undefined => campaigns.find((c) => c.key === state.campaign);

    function showError(error: unknown) {
      const box = el('#page-error');
      box.textContent = error instanceof Error ? error.message : 'Request failed.';
      box.classList.remove('hidden');
    }

    function showNote(text: string) {
      const box = el('#page-note');
      box.textContent = text;
      box.classList.toggle('hidden', !text);
    }

    function queryString(): string {
      const query = new URLSearchParams({ campaign: state.campaign, stage: state.stage, page: String(state.page) });
      if (state.q) query.set('q', state.q);
      if (state.vertical) query.set('vertical', state.vertical);
      if (state.market) query.set('market', state.market);
      query.set('qualified', String(state.qualifiedOnly));
      return query.toString();
    }

    function renderCampaigns() {
      el('#campaign-tabs').innerHTML = campaigns.map((campaign) => {
        const active = campaign.key === state.campaign;
        return `<button type="button" data-campaign="${esc(campaign.key)}" aria-pressed="${active}" title="${esc(campaign.description)}" class="rounded-md border px-3 py-1.5 text-sm font-medium transition ${active ? 'border-[var(--dark)] bg-[var(--dark)] text-white' : 'border-[var(--line)] bg-white hover:border-[var(--accent)]'}">${esc(campaign.name)}</button>`;
      }).join('');
      const current = currentCampaign();
      if (!current) return;
      el('#campaign-summary').textContent = current.sent
        ? `${current.sent.toLocaleString()} sent · ${current.replied.toLocaleString()} replied · ${current.reply_rate}% reply rate`
        : 'Nothing sent yet';
      el('#bulk-prep').textContent = current.prep_label;
    }

    async function loadResults() {
      const body = el('#campaign-results-body');
      const { results } = await api(`/api/outreach/campaigns/${encodeURIComponent(state.campaign)}/results`) as { results: CampaignResult[] };
      body.innerHTML = results.length ? `
        <table class="min-w-full border-collapse">
          <thead><tr class="border-b border-[var(--line)] text-left text-[var(--muted)]"><th class="py-1.5 pr-4 font-medium">Market</th><th class="py-1.5 pr-4 font-medium">Niche</th><th class="py-1.5 pr-4 font-medium">Sent</th><th class="py-1.5 pr-4 font-medium">Replied</th><th class="py-1.5 font-medium">Reply rate</th></tr></thead>
          <tbody>${results.map((row) => `<tr class="border-b border-[var(--line)] last:border-0"><td class="py-1.5 pr-4">${esc(row.market.replace(/, USA$/, ''))}</td><td class="py-1.5 pr-4">${esc(row.vertical.replaceAll('_', ' '))}</td><td class="py-1.5 pr-4">${esc(row.sent)}</td><td class="py-1.5 pr-4">${esc(row.replied)}</td><td class="py-1.5">${esc(row.reply_rate)}%</td></tr>`).join('')}</tbody>
        </table>` : '<p class="text-[var(--muted)]">Nothing sent in this campaign yet.</p>';
    }

    function renderTabs(counts: Record<string, number>) {
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((node) => {
        node.textContent = String(counts[node.dataset.count || ''] ?? 0);
      });
      document.querySelectorAll<HTMLButtonElement>('[data-stage]').forEach((button) => {
        const active = button.dataset.stage === state.stage;
        button.classList.toggle('border-[var(--dark)]', active);
        button.classList.toggle('ring-1', active);
        button.classList.toggle('ring-[var(--dark)]', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    function renderOptions(select: HTMLSelectElement, values: string[], current: string, format: (v: string) => string) {
      const first = select.options[0]?.outerHTML ?? '';
      select.innerHTML = first + values.map((v) => `<option value="${esc(v)}">${esc(format(v))}</option>`).join('');
      select.value = current;
    }

    function whenFor(row: Row): string {
      if (state.stage === 'in_gmail') return shortDate(row.gmail_draft_created_at);
      if (state.stage === 'contacted') {
        return shortDate(row.contacted_at) + (row.gmail_draft_left_at ? ' · left Gmail' : '');
      }
      return shortDate(row.updated_at);
    }

    function actionFor(row: Row): string {
      if (row.stage === 'to_prep' && row.cooldown_until) return '';
      if (row.stage === 'to_prep') return `<button type="button" data-prep="${esc(row.place_id)}" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium">Prep</button>`;
      if (row.stage === 'verify') return `<button type="button" data-site-ok="${esc(row.place_id)}" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium">Site is OK</button>`;
      if (row.kind === 'candidate') return `<a href="/prospects/${encodeURIComponent(row.place_id)}" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium">Open</a>`;
      if (row.stage === 'in_gmail') return `<a href="${esc(gmailDraftUrl(row.gmail_message_id))}" target="_blank" rel="noreferrer" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium">Open in Gmail</a>`;
      return '';
    }

    function renderRows() {
      const body = el('#rows');
      body.innerHTML = rows.map((row) => `
        <tr class="${row.kind === 'queue' ? 'cursor-pointer ' : ''}align-top hover:bg-[var(--surface-muted)]/50" ${row.id ? `data-open="${esc(row.id)}"` : ''}>
          <td class="px-4 py-3"><input type="checkbox" data-select="${esc(rowKey(row))}" aria-label="Select ${esc(row.name)}" ${selected.has(rowKey(row)) ? 'checked' : ''} /></td>
          <td class="max-w-xs px-3 py-3">
            <a href="/prospects/${encodeURIComponent(row.place_id)}" class="font-medium hover:underline">${esc(row.name)}</a>
            <div class="mt-0.5 text-xs text-[var(--muted)]">${esc([row.city, row.vertical?.replaceAll('_', ' ')].filter(Boolean).join(' · '))}</div>
          </td>
          <td class="px-3 py-3 text-xs">${esc(row.email || row.phone || '—')}</td>
          <td class="whitespace-nowrap px-3 py-3 text-xs"><span class="font-semibold">${esc(row.tier ?? '—')}</span> · ${esc(row.total_score ?? '—')}</td>
          <td class="max-w-sm px-3 py-3 text-xs leading-5">${esc(row.next_step)}</td>
          <td class="whitespace-nowrap px-3 py-3 text-xs text-[var(--muted)]">${esc(whenFor(row))}</td>
          <td class="whitespace-nowrap px-4 py-3 text-right">${actionFor(row)}</td>
        </tr>`).join('');
      el('#empty').classList.toggle('hidden', rows.length > 0);
      el('#when-heading').textContent = state.stage === 'in_gmail' ? 'Draft created'
        : state.stage === 'contacted' ? 'Contacted' : 'Updated';
    }

    function renderSelection() {
      el('#selected-count').textContent = `${selected.size} selected`;
      const canPrep = PREP_STAGES.has(state.stage);
      const canStatus = STATUS_STAGES.has(state.stage);
      el('#bulk-prep').classList.toggle('hidden', !canPrep);
      el('#bulk-status-group').classList.toggle('hidden', !canStatus);
      el('#bulk-status-group').classList.toggle('flex', canStatus);
      el<HTMLButtonElement>('#bulk-prep').disabled = selected.size === 0;
      el<HTMLButtonElement>('#bulk-apply').disabled = selected.size === 0
        || !rows.some((r) => r.id && selected.has(rowKey(r)));
      el<HTMLInputElement>('#select-all').checked = rows.length > 0 && rows.every((r) => selected.has(rowKey(r)));
    }

    async function loadBoard() {
      el('#page-error').classList.add('hidden');
      history.replaceState(null, '', `/outreach?${queryString()}`);
      const query = new URLSearchParams({
        campaign: state.campaign,
        stage: state.stage,
        page: String(state.page),
        qualified_only: String(state.qualifiedOnly),
      });
      if (state.q) query.set('q', state.q);
      if (state.vertical) query.set('vertical', state.vertical);
      if (state.market) query.set('market', state.market);
      const data = await api(`/api/outreach/board?${query}`) as Board;
      rows = data.items;
      [...selected].forEach((key) => { if (!rows.some((r) => rowKey(r) === key)) selected.delete(key); });
      renderTabs(data.counts);
      renderRows();
      renderSelection();
      renderOptions(el<HTMLSelectElement>('#filter-vertical'), data.filters.verticals, state.vertical, (v) => v.replaceAll('_', ' '));
      renderOptions(el<HTMLSelectElement>('#filter-market'), data.filters.markets, state.market, (v) => v.replace(/, USA$/, ''));
      el<HTMLInputElement>('#filter-qualified').disabled = state.stage !== 'to_prep';
      el('#qualified-option').classList.toggle('hidden', currentCampaign()?.uses_audit === false);
      el('#page-label').textContent = `${data.pagination.total.toLocaleString()} in this stage · page ${data.pagination.page} of ${Math.max(data.pagination.total_pages, 1)}`;
      el<HTMLButtonElement>('#prev').disabled = data.pagination.page <= 1;
      el<HTMLButtonElement>('#next').disabled = data.pagination.page >= data.pagination.total_pages;
    }

    async function syncGmail(manual: boolean) {
      if (!gmailConnected) return;
      const button = el<HTMLButtonElement>('#sync-gmail');
      button.disabled = true;
      try {
        const result = await api('/api/outreach/gmail/sync', { method: 'POST' });
        sessionStorage.setItem(SYNC_KEY, String(Date.now()));
        if (result.moved_to_contacted) {
          showNote(`${result.moved_to_contacted} draft${result.moved_to_contacted === 1 ? ' has' : 's have'} left Gmail (sent or deleted), so ${result.moved_to_contacted === 1 ? 'it moved' : 'they moved'} to Contacted.`);
          await loadBoard();
        } else if (manual) {
          showNote(`Checked ${result.checked} draft${result.checked === 1 ? '' : 's'}. Nothing has left Gmail.`);
        }
      } catch (error) {
        if (manual) showError(error);
      } finally {
        button.disabled = false;
      }
    }

    function closeDrawer() {
      el('#drawer').classList.add('hidden');
      el('#drawer-scrim').classList.add('hidden');
    }

    function drawerError(error: unknown) {
      const box = el('#draft-error');
      box.textContent = error instanceof Error ? error.message : 'That didn\'t work.';
      box.classList.remove('hidden');
    }

    function renderDrawer(item: Item) {
      const name = el<HTMLAnchorElement>('#drawer-name');
      name.textContent = item.name || 'Prospect';
      name.href = `/prospects/${encodeURIComponent(item.place_id)}`;
      el('#drawer-next').textContent = `Next: ${item.next_step}`;
      el<HTMLInputElement>('#draft-id').value = item.id;
      el<HTMLInputElement>('#draft-version').value = String(item.version);
      el<HTMLInputElement>('#draft-to').value = item.to_address || '';
      el<HTMLInputElement>('#draft-subject').value = item.subject || '';
      el<HTMLTextAreaElement>('#draft-body').value = item.body || '';
      el<HTMLSelectElement>('#draft-status').value = item.status;
      el<HTMLSelectElement>('#draft-verification').value = item.verification_status;
      el('#draft-error').classList.add('hidden');

      const stop = el<HTMLButtonElement>('#draft-stop');
      stop.dataset.armed = '';
      stop.textContent = 'Do not contact';
      stop.disabled = item.status === 'suppressed';
      stop.dataset.gmail = item.gmail_draft_id && item.stage === 'in_gmail' ? 'true' : '';

      const generate = el<HTMLButtonElement>('#draft-generate');
      generate.textContent = item.body ? 'Regenerate draft' : 'Generate draft';
      generate.disabled = item.channel !== 'email' || !['review', 'attention', 'in_gmail'].includes(item.stage);

      const gmail = el<HTMLButtonElement>('#draft-gmail');
      gmail.disabled = Boolean(item.gmail_block_reason);
      gmail.textContent = item.gmail_draft_id ? 'Gmail draft created' : 'Create Gmail draft';

      const open = el<HTMLAnchorElement>('#draft-open-gmail');
      open.classList.toggle('hidden', !item.gmail_draft_id || item.stage !== 'in_gmail');
      open.classList.toggle('block', Boolean(item.gmail_draft_id) && item.stage === 'in_gmail');
      open.href = gmailDraftUrl(item.gmail_message_id);

      const reason = el('#draft-reason');
      const showReason = Boolean(item.gmail_block_reason) && !item.gmail_draft_id;
      reason.textContent = item.gmail_block_reason || '';
      reason.classList.toggle('hidden', !showReason);

      el('#draft-meta').textContent = [
        item.draft_generated_at ? `Drafted ${new Date(item.draft_generated_at).toLocaleString()}` : '',
        item.gmail_draft_created_at ? `Gmail draft ${new Date(item.gmail_draft_created_at).toLocaleString()}` : '',
        item.gmail_draft_left_at ? 'Left Gmail drafts (sent or deleted)' : '',
        item.contacted_at ? `Contacted ${new Date(item.contacted_at).toLocaleDateString()}` : '',
        item.verification_note || '',
      ].filter(Boolean).join(' · ');
    }

    async function openDrawer(id: string) {
      try {
        const item = await api(`/api/outreach/items/${encodeURIComponent(id)}`) as Item;
        renderDrawer(item);
        el('#drawer').classList.remove('hidden');
        el('#drawer-scrim').classList.remove('hidden');
      } catch (error) {
        showError(error);
      }
    }

    async function refreshDrawer(id: string) {
      renderDrawer(await api(`/api/outreach/items/${encodeURIComponent(id)}`) as Item);
      await loadBoard();
    }

    async function prepare(placeIds: string[]) {
      const box = el('#bulk-result');
      box.className = 'border-b border-[var(--line)] px-4 py-3 text-xs leading-5';
      const names = new Map(rows.map((r) => [r.place_id, r.name || r.place_id]));
      const lines: string[] = [];
      let done = 0;
      for (const placeId of placeIds) {
        box.innerHTML = `Working on ${done + 1} of ${placeIds.length}: ${esc(names.get(placeId))}… Keep this page open.<br>${lines.join('<br>')}`;
        try {
          const result = await api(`/api/outreach/fast-track/${encodeURIComponent(placeId)}`, {
            method: 'POST', body: JSON.stringify({ gmail: true, campaign: state.campaign }),
          });
          lines.push(result.ok
            ? `<span class="text-emerald-700">✓ ${esc(names.get(placeId))}: in Gmail</span>`
            : `<span class="text-red-700">✗ ${esc(names.get(placeId))}: stopped at ${esc(STEP_LABELS[result.failed_step] || result.failed_step)}: ${esc(result.detail)}</span>`);
          if (result.ok) selected.delete(placeId);
        } catch (error) {
          lines.push(`<span class="text-red-700">✗ ${esc(names.get(placeId))}: ${esc(error instanceof Error ? error.message : error)}</span>`);
        }
        done += 1;
      }
      box.innerHTML = `Finished ${done} of ${placeIds.length}. Review the drafts in Gmail before sending.<br>${lines.join('<br>')}`;
      await loadBoard();
    }

    el('#campaign-tabs').addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-campaign]');
      if (!button?.dataset.campaign || button.dataset.campaign === state.campaign) return;
      state.campaign = button.dataset.campaign;
      state.stage = 'to_prep';
      state.vertical = '';
      state.market = '';
      state.page = 1;
      selected.clear();
      el('#bulk-result').classList.add('hidden');
      renderCampaigns();
      el<HTMLDetailsElement>('#campaign-results').open = false;
      loadBoard().catch(showError);
    });

    el<HTMLDetailsElement>('#campaign-results').addEventListener('toggle', (event) => {
      if ((event.target as HTMLDetailsElement).open) loadResults().catch(showError);
    });

    el('#stage-tabs').addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-stage]');
      if (!button?.dataset.stage) return;
      state.stage = button.dataset.stage;
      state.page = 1;
      selected.clear();
      el('#bulk-result').classList.add('hidden');
      loadBoard().catch(showError);
    });

    el<HTMLInputElement>('#filter-q').addEventListener('input', (event) => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        state.q = (event.target as HTMLInputElement).value.trim();
        state.page = 1;
        loadBoard().catch(showError);
      }, 250);
    });
    el<HTMLSelectElement>('#filter-vertical').addEventListener('change', (event) => {
      state.vertical = (event.target as HTMLSelectElement).value;
      state.page = 1;
      loadBoard().catch(showError);
    });
    el<HTMLSelectElement>('#filter-market').addEventListener('change', (event) => {
      state.market = (event.target as HTMLSelectElement).value;
      state.page = 1;
      loadBoard().catch(showError);
    });
    el<HTMLInputElement>('#filter-qualified').addEventListener('change', (event) => {
      state.qualifiedOnly = (event.target as HTMLInputElement).checked;
      state.page = 1;
      loadBoard().catch(showError);
    });

    el('#rows').addEventListener('change', (event) => {
      const box = event.target as HTMLInputElement;
      const key = box.dataset.select;
      if (!key) return;
      if (box.checked) selected.add(key); else selected.delete(key);
      renderSelection();
    });

    el('#rows').addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target.closest('[data-select]') || target.closest('a')) return;
      const prep = target.closest<HTMLButtonElement>('[data-prep]');
      if (prep?.dataset.prep) {
        prep.disabled = true;
        prepare([prep.dataset.prep]).catch(showError);
        return;
      }
      const siteOk = target.closest<HTMLButtonElement>('[data-site-ok]');
      if (siteOk?.dataset.siteOk) {
        siteOk.disabled = true;
        api(`/api/prospects/${encodeURIComponent(siteOk.dataset.siteOk)}/contact`, {
          method: 'POST', body: JSON.stringify({ site_checked: true }),
        }).then(loadBoard).catch(showError);
        return;
      }
      const row = target.closest<HTMLElement>('[data-open]');
      if (row?.dataset.open) openDrawer(row.dataset.open);
    });

    el<HTMLInputElement>('#select-all').addEventListener('change', (event) => {
      const on = (event.target as HTMLInputElement).checked;
      rows.forEach((row) => { if (on) selected.add(rowKey(row)); else selected.delete(rowKey(row)); });
      renderRows();
      renderSelection();
    });

    el<HTMLButtonElement>('#bulk-prep').addEventListener('click', () => {
      const placeIds = rows.filter((r) => selected.has(rowKey(r))).map((r) => r.place_id);
      if (placeIds.length) prepare(placeIds).catch(showError);
    });

    el<HTMLButtonElement>('#bulk-apply').addEventListener('click', async () => {
      const ids = rows.filter((r) => r.id && selected.has(rowKey(r))).map((r) => r.id as string);
      if (!ids.length) return;
      const status = el<HTMLSelectElement>('#bulk-status').value;
      const box = el('#bulk-result');
      try {
        const result = await api('/api/outreach/bulk/status', { method: 'POST', body: JSON.stringify({ ids, status }) });
        const failed = (result.results as { id: string; ok: boolean; detail?: string }[]).filter((r) => !r.ok);
        box.className = `border-b border-[var(--line)] px-4 py-3 text-xs leading-5 ${failed.length ? 'text-red-700' : 'text-emerald-700'}`;
        box.innerHTML = `Updated ${result.updated} of ${ids.length}.`
          + (failed.length ? '<br>' + failed.map((f) => `${esc(rows.find((r) => r.id === f.id)?.name || f.id)}: ${esc(f.detail)}`).join('<br>') : '');
        selected.clear();
        await loadBoard();
      } catch (error) {
        showError(error);
      }
    });

    el('#sync-gmail').addEventListener('click', () => { syncGmail(true); });
    el<HTMLButtonElement>('#prev').addEventListener('click', () => { state.page -= 1; loadBoard().catch(showError); });
    el<HTMLButtonElement>('#next').addEventListener('click', () => { state.page += 1; loadBoard().catch(showError); });
    el('#drawer-close').addEventListener('click', closeDrawer);
    el('#drawer-scrim').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeDrawer(); });

    const draftId = (): string => el<HTMLInputElement>('#draft-id').value;
    const draftVersion = (): number => Number(el<HTMLInputElement>('#draft-version').value);

    el<HTMLButtonElement>('#draft-generate').addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      el('#draft-error').classList.add('hidden');
      try {
        await api(`/api/outreach/items/${encodeURIComponent(draftId())}/regenerate-synced`, {
          method: 'POST', body: JSON.stringify({ expected_version: draftVersion() }),
        });
        await refreshDrawer(draftId());
      } catch (error) {
        drawerError(error);
        button.disabled = false;
      }
    });

    el<HTMLButtonElement>('#draft-gmail').addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      el('#draft-error').classList.add('hidden');
      try {
        await api(`/api/outreach/items/${encodeURIComponent(draftId())}/review-gmail-draft`, {
          method: 'POST',
          body: JSON.stringify({
            expected_version: draftVersion(),
            to_address: el<HTMLInputElement>('#draft-to').value,
            subject: el<HTMLInputElement>('#draft-subject').value,
            body: el<HTMLTextAreaElement>('#draft-body').value,
          }),
        });
        await refreshDrawer(draftId());
      } catch (error) {
        drawerError(error);
        button.disabled = false;
      }
    });

    el<HTMLFormElement>('#draft-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      el('#draft-error').classList.add('hidden');
      try {
        await api(`/api/outreach/items/${encodeURIComponent(draftId())}/save-synced`, {
          method: 'PATCH',
          body: JSON.stringify({
            expected_version: draftVersion(),
            to_address: el<HTMLInputElement>('#draft-to').value || null,
            subject: el<HTMLInputElement>('#draft-subject').value || null,
            body: el<HTMLTextAreaElement>('#draft-body').value || null,
            status: el<HTMLSelectElement>('#draft-status').value,
            verification_status: el<HTMLSelectElement>('#draft-verification').value,
          }),
        });
        await refreshDrawer(draftId());
      } catch (error) {
        drawerError(error);
      }
    });

    el<HTMLButtonElement>('#draft-stop').addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      if (!button.dataset.armed) {
        button.dataset.armed = 'true';
        button.textContent = 'Confirm: stop all outreach to this business';
        return;
      }
      button.disabled = true;
      el('#draft-error').classList.add('hidden');
      try {
        await api(`/api/outreach/items/${encodeURIComponent(draftId())}/do-not-contact`, { method: 'POST' });
        if (button.dataset.gmail) showNote('Stopped. A Gmail draft for this business is still in Gmail, so delete it there.');
        closeDrawer();
        await loadBoard();
      } catch (error) {
        drawerError(error);
        button.disabled = false;
      }
    });

    async function init() {
      el<HTMLInputElement>('#filter-q').value = state.q;
      el<HTMLInputElement>('#filter-qualified').checked = state.qualifiedOnly;
      const integrations = await api('/api/outreach/integrations');
      gmailConnected = Boolean(integrations.gmail_configured);
      el('#gmail-status').textContent = gmailConnected ? `Gmail · ${integrations.gmail_sender_email || 'connected'}` : 'Gmail not connected';
      el<HTMLButtonElement>('#sync-gmail').disabled = !gmailConnected;
      campaigns = (await api('/api/outreach/campaigns')).campaigns as Campaign[];
      if (!currentCampaign()) state.campaign = campaigns[0]?.key || 'seo_websites';
      renderCampaigns();
      await loadBoard();
      let lastSync = 0;
      try { lastSync = Number(sessionStorage.getItem(SYNC_KEY) || 0); } catch { lastSync = 0; }
      if (Date.now() - lastSync > SYNC_EVERY_MS) await syncGmail(false);
    }

    init().catch(showError);
  </script>
</AppLayout>
