---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout
  title="Prospects"
  description="Search, filter, inspect, and prioritize current opportunities."
>
  <div class="space-y-5">
    <section class="rounded-lg border border-[var(--line)] bg-white p-4">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(200px,1.3fr)_repeat(7,minmax(110px,0.7fr))]">
        <div>
          <label for="search" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            Search
          </label>
          <input
            id="search"
            type="search"
            placeholder="Business, city, phone, address…"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none transition focus:border-[var(--accent)]"
          />
        </div>

        <div>
          <label for="qualification" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            Verdict
          </label>
          <select
            id="qualification"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--accent)]"
          >
            <option value="">All verdicts</option>
          </select>
        </div>

        <div>
          <label for="market" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            Market
          </label>
          <select
            id="market"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--accent)]"
          >
            <option value="">All markets</option>
          </select>
        </div>

        <div>
          <label for="city" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            City
          </label>
          <select
            id="city"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--accent)]"
          >
            <option value="">All cities</option>
          </select>
        </div>

        <div>
          <label for="vertical" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            Niche
          </label>
          <select
            id="vertical"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--accent)]"
          >
            <option value="">All niches</option>
          </select>
        </div>

        <div>
          <label for="tier" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            Tier
          </label>
          <select
            id="tier"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--accent)]"
          >
            <option value="">All tiers</option>
            <option value="A">Tier A</option>
            <option value="B">Tier B</option>
            <option value="C">Tier C</option>
            <option value="D">Tier D</option>
          </select>
        </div>

        <div>
          <label for="contact" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            Contact
          </label>
          <select
            id="contact"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--accent)]"
          >
            <option value="">Any contact</option>
            <option value="email">Email</option>
            <option value="phone">Phone only</option>
            <option value="none">No contact</option>
          </select>
        </div>

        <div>
          <label for="label" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">
            Label
          </label>
          <select
            id="label"
            class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm outline-none focus:border-[var(--accent)]"
          >
            <option value="">Any label</option>
          </select>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-[var(--line)] pt-4">
        <button
          id="filter-established"
          type="button"
          data-toggle-key="established"
          class="rounded-full border border-[var(--line)] bg-white px-3 py-1.5 text-xs font-medium"
        >
          Established
        </button>

        <button
          id="filter-trading"
          type="button"
          data-toggle-key="trading"
          class="rounded-full border border-[var(--line)] bg-white px-3 py-1.5 text-xs font-medium"
        >
          Recently active
        </button>

        <button
          id="filter-category"
          type="button"
          data-toggle-key="category_opportunity"
          class="rounded-full border border-[var(--line)] bg-white px-3 py-1.5 text-xs font-medium"
        >
          Category opportunity
        </button>

        <button
          id="clear-filters"
          type="button"
          class="ml-auto rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium hover:border-[var(--accent)]"
        >
          Clear filters
        </button>
      </div>
    </section>

    <section class="overflow-hidden rounded-lg border border-[var(--line)] bg-white">
      <div class="flex items-center justify-between border-b border-[var(--line)] px-4 py-3">
        <div>
          <div class="text-sm font-medium">
            Current opportunities
          </div>
          <div id="result-summary" class="mt-0.5 text-xs text-[var(--muted)]">
            Loading…
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-2">
        <span id="batch-status" class="text-xs text-[var(--muted)]"></span>
        <button
          id="batch-audit"
          type="button"
          disabled
          class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium hover:border-[var(--accent)] disabled:cursor-not-allowed disabled:opacity-40"
        >
          Create audit reports (0)
        </button>
        <button
          id="batch-ev"
          type="button"
          disabled
          class="rounded-md bg-[var(--dark)] px-3 py-1.5 text-xs font-medium text-white disabled:cursor-not-allowed disabled:opacity-40"
        >
          Prep for EV Permits (0)
        </button>
        <select
          id="page-size"
          class="rounded-md border border-[var(--line)] bg-white px-2 py-1.5 text-xs"
        >
          <option value="25">25 / page</option>
          <option value="50">50 / page</option>
          <option value="100">100 / page</option>
        </select>
        </div>
      </div>

      <div id="prospect-error" class="hidden border-b border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

      <div class="overflow-x-auto">
        <table class="min-w-full border-collapse">
          <thead class="bg-[var(--surface-muted)]">
            <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--muted)]">
              <th class="w-8 px-4 py-3">
                <input id="select-page" type="checkbox" aria-label="Select all on this page" />
              </th>
              <th class="px-4 py-3">Business</th>
              <th class="px-4 py-3">Verdict</th>
              <th class="px-4 py-3">Score</th>
              <th class="px-4 py-3">Fit</th>
              <th class="px-4 py-3">Tier</th>
              <th class="px-4 py-3">Reviews</th>
              <th class="px-4 py-3">Contact</th>
              <th class="px-4 py-3">Website</th>
              <th class="px-4 py-3">Labels</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>

          <tbody id="prospect-rows" class="divide-y divide-[var(--line)]"></tbody>
        </table>
      </div>

      <div
        id="empty-state"
        class="hidden px-6 py-14 text-center text-sm text-[var(--muted)]"
      >
        No prospects match the current filters.
      </div>

      <div class="flex items-center justify-between border-t border-[var(--line)] px-4 py-3">
        <div id="page-label" class="text-xs text-[var(--muted)]">
          Page —
        </div>

        <div class="flex gap-2">
          <button
            id="prev-page"
            type="button"
            class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40"
          >
            Previous
          </button>
          <button
            id="next-page"
            type="button"
            class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40"
          >
            Next
          </button>
        </div>
      </div>
    </section>
  </div>

  <script>
    type Prospect = {
      place_id: string;
      name: string | null;
      city: string | null;
      vertical: string | null;
      total_score: number;
      tier: string | null;
      headline_gap: string | null;
      phone: string | null;
      email: string | null;
      website_url: string | null;
      rating: number | null;
      review_count: number | null;
      confirmed_trading: boolean;
      category_opportunity: boolean;
      established: boolean;
      real_gap_count: number;
      labels: string[];
      market: string | null;
      needs_manual_check: boolean;
      fit_score: number | null;
      qualification: string | null;
    };

    type ProspectResponse = {
      items: Prospect[];
      pagination: {
        page: number;
        page_size: number;
        total: number;
        total_pages: number;
      };
    };

    type MetaResponse = {
      cities: string[];
      verticals: string[];
      markets: string[];
      labels: Record<string, string>;
      qualifications: Record<string, string>;
      tiers: string[];
      total_prospects: number;
    };

    const $ = <T extends Element>(selector: string): T | null =>
      document.querySelector<T>(selector);

    const searchInput = $('#search') as HTMLInputElement;
    const citySelect = $('#city') as HTMLSelectElement;
    const verticalSelect = $('#vertical') as HTMLSelectElement;
    const tierSelect = $('#tier') as HTMLSelectElement;
    const contactSelect = $('#contact') as HTMLSelectElement;
    const marketSelect = $('#market') as HTMLSelectElement;
    const labelSelect = $('#label') as HTMLSelectElement;
    const qualificationSelect = $('#qualification') as HTMLSelectElement;
    const batchButton = $('#batch-audit') as HTMLButtonElement;
    const batchStatus = $('#batch-status') as HTMLSpanElement;
    const batchEvButton = $('#batch-ev') as HTMLButtonElement;
    const prospectsById = new Map<string, Prospect>();
    const selectPage = $('#select-page') as HTMLInputElement;
    const selected = new Set<string>();
    let labelNames: Record<string, string> = {};
    let verdictNames: Record<string, string> = {};
    const VERDICT_STYLES: Record<string, string> = {
      qualified: 'bg-emerald-50 text-emerald-800',
      call_first: 'bg-blue-50 text-blue-800',
      verify_first: 'bg-amber-50 text-amber-800',
    };
    const pageSizeSelect = $('#page-size') as HTMLSelectElement;

    const rows = $('#prospect-rows') as HTMLTableSectionElement;
    const errorBox = $('#prospect-error') as HTMLDivElement;
    const emptyState = $('#empty-state') as HTMLDivElement;
    const resultSummary = $('#result-summary') as HTMLDivElement;
    const pageLabel = $('#page-label') as HTMLDivElement;
    const prevButton = $('#prev-page') as HTMLButtonElement;
    const nextButton = $('#next-page') as HTMLButtonElement;

    const state = {
      page: 1,
      pageSize: 25,
      search: '',
      city: '',
      vertical: '',
      tier: '',
      contact: '',
      market: '',
      label: '',
      qualification: '',
      trading: false,
      // Volume first: show every lead by default; labels and filters narrow it.
      established: false,
      categoryOpportunity: false,
    };

    let debounceTimer: number | undefined;

    const escapeHtml = (value: string | null | undefined) =>
      String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    function readUrlState() {
      const params = new URLSearchParams(window.location.search);

      state.page = Math.max(1, Number(params.get('page') || 1));
      state.pageSize = Math.min(
        100,
        Math.max(1, Number(params.get('page_size') || 25)),
      );

      state.search = params.get('search') || '';
      state.city = params.get('city') || '';
      state.vertical = params.get('vertical') || '';
      state.tier = params.get('tier') || '';
      state.contact = params.get('contact') || '';
      state.market = params.get('market') || '';
      state.label = params.get('label') || '';
      state.qualification = params.get('qualification') || '';

      state.trading = params.get('trading') === 'true';

      state.established = params.get('established') === 'true';

      state.categoryOpportunity =
        params.get('category_opportunity') === 'true';
    }

    function syncControls() {
      searchInput.value = state.search;
      citySelect.value = state.city;
      verticalSelect.value = state.vertical;
      tierSelect.value = state.tier;
      contactSelect.value = state.contact;
      marketSelect.value = state.market;
      labelSelect.value = state.label;
      qualificationSelect.value = state.qualification;
      pageSizeSelect.value = String(state.pageSize);

      updateToggleStyles();
    }

    function updateToggleStyles() {
      const toggleMap = [
        ['#filter-established', state.established],
        ['#filter-trading', state.trading],
        ['#filter-category', state.categoryOpportunity],
      ] as const;

      toggleMap.forEach(([selector, active]) => {
        const button = $(selector) as HTMLButtonElement | null;
        if (!button) return;

        button.className = active
          ? 'rounded-full border border-[var(--dark)] bg-[var(--dark)] px-3 py-1.5 text-xs font-medium text-white'
          : 'rounded-full border border-[var(--line)] bg-white px-3 py-1.5 text-xs font-medium';
      });
    }

    function buildApiParams() {
      const params = new URLSearchParams();

      params.set('page', String(state.page));
      params.set('page_size', String(state.pageSize));

      if (state.search) params.set('search', state.search);
      if (state.city) params.set('city', state.city);
      if (state.vertical) params.set('vertical', state.vertical);
      if (state.tier) params.set('tier', state.tier);
      if (state.contact) params.set('contact', state.contact);
      if (state.market) params.set('market', state.market);
      if (state.label) params.set('label', state.label);
      if (state.qualification) params.set('qualification', state.qualification);
      if (state.trading) params.set('trading', 'true');
      if (state.established) params.set('established', 'true');
      if (state.categoryOpportunity) {
        params.set('category_opportunity', 'true');
      }

      return params;
    }

    function syncBrowserUrl() {
      const params = buildApiParams();

      if (state.page === 1) params.delete('page');
      if (state.pageSize === 25) params.delete('page_size');

      const query = params.toString();

      history.replaceState(
        null,
        '',
        query ? `/prospects?${query}` : '/prospects',
      );
    }

    const LABEL_STYLES: Record<string, string> = {
      established: 'bg-[var(--accent-soft)]',
      no_website: 'bg-sky-50 text-sky-800',
      verify_first: 'bg-red-50 text-red-700',
      site_down: 'bg-red-50 text-red-700',
      franchise: 'bg-neutral-100 text-neutral-600',
      no_contact: 'bg-neutral-100 text-neutral-600',
      email_found: 'bg-emerald-50 text-emerald-800',
      phone_only: 'bg-amber-50 text-amber-800',
    };

    function signalBadges(item: Prospect) {
      const badges = (item.labels || []).map((key) => {
        const style = LABEL_STYLES[key] || 'bg-[var(--surface-muted)]';
        const name = labelNames[key] || key.replaceAll('_', ' ');
        return `<span class="rounded-full ${style} px-2 py-1 text-[11px] font-medium">${escapeHtml(name)}</span>`;
      });

      if (item.category_opportunity) {
        badges.push(
          '<span class="rounded-full bg-amber-50 px-2 py-1 text-[11px] font-medium text-amber-800">Category</span>',
        );
      }

      if (item.needs_manual_check && !(item.labels || []).includes('verify_first')) {
        badges.push(
          '<span class="rounded-full bg-red-50 px-2 py-1 text-[11px] font-medium text-red-700">Check</span>',
        );
      }

      return badges.join(' ');
    }

    function updateBatchButton() {
      batchButton.textContent = `Create audit reports (${selected.size})`;
      batchButton.disabled = selected.size === 0;
      const electricians = evSelection().length;
      batchEvButton.textContent = `Prep for EV Permits (${electricians})`;
      batchEvButton.disabled = electricians === 0;
    }

    function evSelection(): Prospect[] {
      return Array.from(selected)
        .map((id) => prospectsById.get(id))
        .filter((item): item is Prospect => item?.vertical === 'electrician');
    }

    function renderRows(items: Prospect[]) {
      items.forEach((item) => prospectsById.set(item.place_id, item));
      rows.innerHTML = '';

      if (!items.length) {
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      rows.innerHTML = items
        .map((item) => {
          const contact = item.email
            ? escapeHtml(item.email)
            : item.phone
              ? escapeHtml(item.phone)
              : '—';

          const website = item.website_url
            ? `<a href="${escapeHtml(item.website_url)}" target="_blank" rel="noreferrer" class="text-xs underline decoration-[var(--line)] underline-offset-2">Visit</a>`
            : '<span class="text-xs text-[var(--muted)]">None</span>';

          return `
            <tr class="align-top hover:bg-[var(--surface-muted)]/50">
              <td class="px-4 py-4">
                <input
                  type="checkbox"
                  data-select-id="${escapeHtml(item.place_id)}"
                  ${selected.has(item.place_id) ? 'checked' : ''}
                  aria-label="Select ${escapeHtml(item.name)}"
                />
              </td>
              <td class="px-4 py-4">
                <div class="font-medium">${escapeHtml(item.name) || 'Unnamed business'}</div>
                <div class="mt-1 text-xs text-[var(--muted)]">
                  ${escapeHtml(item.city)}${item.vertical ? ` · ${escapeHtml(item.vertical.replaceAll('_', ' '))}` : ''}
                </div>
                ${
                  item.headline_gap
                    ? `<div class="mt-2 max-w-xl text-xs leading-5 text-[var(--muted)]">${escapeHtml(item.headline_gap)}</div>`
                    : ''
                }
              </td>

              <td class="px-4 py-4">
                <span class="whitespace-nowrap rounded-full ${VERDICT_STYLES[item.qualification || ''] || 'bg-neutral-100 text-neutral-600'} px-2 py-1 text-[11px] font-medium">
                  ${escapeHtml(verdictNames[item.qualification || ''] || 'Not rescored')}
                </span>
              </td>

              <td class="px-4 py-4">
                <div class="text-lg font-semibold">${item.total_score}</div>
              </td>

              <td class="px-4 py-4 text-sm">${item.fit_score ?? '—'}</td>

              <td class="px-4 py-4">
                <span class="inline-flex min-w-8 justify-center rounded-md border border-[var(--line)] px-2 py-1 text-xs font-semibold">
                  ${escapeHtml(item.tier) || '—'}
                </span>
              </td>

              <td class="px-4 py-4">
                <div class="text-sm font-medium">${item.review_count ?? 0}</div>
                <div class="mt-1 text-xs text-[var(--muted)]">
                  ${item.rating ?? '—'}★
                </div>
              </td>

              <td class="px-4 py-4 text-xs">
                ${contact}
              </td>

              <td class="px-4 py-4">
                ${website}
              </td>

              <td class="px-4 py-4">
                <div class="flex max-w-[260px] flex-wrap gap-1.5">
                  ${signalBadges(item)}
                </div>
              </td>

              <td class="px-4 py-4 text-right">
                <a
                  href="/prospects/${encodeURIComponent(item.place_id)}"
                  class="inline-flex rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium hover:border-[var(--accent)]"
                >
                  View
                </a>
              </td>
            </tr>
          `;
        })
        .join('');

      rows.querySelectorAll<HTMLInputElement>('[data-select-id]').forEach((box) => {
        box.addEventListener('change', () => {
          const id = box.dataset.selectId || '';
          if (box.checked) selected.add(id);
          else selected.delete(id);
          updateBatchButton();
        });
      });
      selectPage.checked = items.length > 0 && items.every((i) => selected.has(i.place_id));
    }

    async function loadMeta() {
      const response = await fetch('/api/prospects/meta');

      if (!response.ok) {
        throw new Error(`Metadata API returned ${response.status}`);
      }

      const meta = (await response.json()) as MetaResponse;

      meta.cities.forEach((city) => {
        citySelect.insertAdjacentHTML(
          'beforeend',
          `<option value="${escapeHtml(city)}">${escapeHtml(city)}</option>`,
        );
      });

      meta.verticals.forEach((vertical) => {
        verticalSelect.insertAdjacentHTML(
          'beforeend',
          `<option value="${escapeHtml(vertical)}">${escapeHtml(vertical.replaceAll('_', ' '))}</option>`,
        );
      });

      (meta.markets || []).forEach((market) => {
        marketSelect.insertAdjacentHTML(
          'beforeend',
          `<option value="${escapeHtml(market)}">${escapeHtml(market.replace(/, USA$/, ''))}</option>`,
        );
      });

      verdictNames = meta.qualifications || {};
      Object.entries(verdictNames).forEach(([key, name]) => {
        qualificationSelect.insertAdjacentHTML(
          'beforeend',
          `<option value="${escapeHtml(key)}">${escapeHtml(name)}</option>`,
        );
      });

      labelNames = meta.labels || {};
      Object.entries(labelNames).forEach(([key, name]) => {
        labelSelect.insertAdjacentHTML(
          'beforeend',
          `<option value="${escapeHtml(key)}">${escapeHtml(name)}</option>`,
        );
      });

      syncControls();
    }

    async function loadProspects() {
      errorBox.classList.add('hidden');

      const params = buildApiParams();
      syncBrowserUrl();

      try {
        const response = await fetch(`/api/prospects?${params.toString()}`);

        if (!response.ok) {
          throw new Error(`Prospect API returned ${response.status}`);
        }

        const data = (await response.json()) as ProspectResponse;

        renderRows(data.items);

        resultSummary.textContent =
          `${data.pagination.total.toLocaleString()} matching prospects`;

        pageLabel.textContent =
          `Page ${data.pagination.page} of ${Math.max(data.pagination.total_pages, 1)}`;

        prevButton.disabled = data.pagination.page <= 1;
        nextButton.disabled =
          data.pagination.page >= data.pagination.total_pages ||
          data.pagination.total_pages === 0;
      } catch (error) {
        rows.innerHTML = '';
        emptyState.classList.add('hidden');

        errorBox.textContent =
          error instanceof Error
            ? error.message
            : 'Unable to load prospects.';

        errorBox.classList.remove('hidden');
        resultSummary.textContent = 'Unable to load prospects';
      }
    }

    function refreshFromControls() {
      state.page = 1;
      state.city = citySelect.value;
      state.vertical = verticalSelect.value;
      state.tier = tierSelect.value;
      state.contact = contactSelect.value;
      state.market = marketSelect.value;
      state.label = labelSelect.value;
      state.qualification = qualificationSelect.value;
      state.pageSize = Number(pageSizeSelect.value);

      loadProspects();
    }

    searchInput.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);

      debounceTimer = window.setTimeout(() => {
        state.search = searchInput.value.trim();
        state.page = 1;
        loadProspects();
      }, 300);
    });

    [citySelect, verticalSelect, tierSelect, contactSelect, marketSelect, labelSelect, qualificationSelect, pageSizeSelect]
      .forEach((element) => {
        element.addEventListener('change', refreshFromControls);
      });

    document.querySelectorAll<HTMLButtonElement>('[data-toggle-key]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.toggleKey;

          if (key === 'established') {
            state.established = !state.established;
          }

          if (key === 'trading') {
            state.trading = !state.trading;
          }

          if (key === 'category_opportunity') {
            state.categoryOpportunity = !state.categoryOpportunity;
          }

          state.page = 1;
          updateToggleStyles();
          loadProspects();
        });
      });

    $('#clear-filters')?.addEventListener('click', () => {
      state.page = 1;
      state.pageSize = 25;
      state.search = '';
      state.city = '';
      state.vertical = '';
      state.tier = '';
      state.contact = '';
      state.market = '';
      state.label = '';
      state.qualification = '';
      state.trading = false;
      state.established = false;
      state.categoryOpportunity = false;

      syncControls();
      loadProspects();
    });

    prevButton.addEventListener('click', () => {
      if (state.page <= 1) return;
      state.page -= 1;
      loadProspects();
    });

    nextButton.addEventListener('click', () => {
      state.page += 1;
      loadProspects();
    });

    selectPage.addEventListener('change', () => {
      rows.querySelectorAll<HTMLInputElement>('[data-select-id]').forEach((box) => {
        box.checked = selectPage.checked;
        const id = box.dataset.selectId || '';
        if (selectPage.checked) selected.add(id);
        else selected.delete(id);
      });
      updateBatchButton();
    });

    batchButton.addEventListener('click', async () => {
      const ids = Array.from(selected).slice(0, 50);
      if (!ids.length) return;
      batchButton.disabled = true;
      batchStatus.textContent = `Creating ${ids.length} report${ids.length === 1 ? '' : 's'}…`;
      try {
        const response = await fetch('/api/audit-reports/batch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ place_ids: ids }),
        });
        if (!response.ok) throw new Error(`Batch API returned ${response.status}`);
        const data = await response.json();
        batchStatus.textContent =
          `${data.created} report${data.created === 1 ? '' : 's'} created` +
          (data.skipped ? `, ${data.skipped} skipped (nothing reportable)` : '');
        ids.forEach((id) => selected.delete(id));
        await loadProspects();
      } catch (error) {
        batchStatus.textContent =
          error instanceof Error ? error.message : 'Batch failed';
      } finally {
        updateBatchButton();
      }
    });

    batchEvButton.addEventListener('click', async () => {
      const leads = evSelection().slice(0, 50);
      if (!leads.length) return;
      batchEvButton.disabled = true;
      batchButton.disabled = true;
      const stopped: string[] = [];
      let drafted = 0;
      for (const [index, lead] of leads.entries()) {
        batchStatus.textContent = `Prepping ${index + 1} of ${leads.length}: ${lead.name}. Keep this page open.`;
        try {
          const response = await fetch(`/api/outreach/fast-track/${encodeURIComponent(lead.place_id)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ gmail: true, campaign: 'ev_permits' }),
          });
          const result = await response.json().catch(() => ({}));
          if (response.ok && result.ok) {
            drafted += 1;
            selected.delete(lead.place_id);
          } else {
            stopped.push(`${lead.name}: ${result.detail || `API returned ${response.status}`}`);
          }
        } catch (error) {
          stopped.push(`${lead.name}: ${error instanceof Error ? error.message : 'request failed'}`);
        }
      }
      batchStatus.textContent = [
        `${drafted} EV draft${drafted === 1 ? '' : 's'} in Gmail`,
        ...stopped,
      ].join(' · ');
      await loadProspects();
      updateBatchButton();
    });

    readUrlState();

    try {
      await loadMeta();
      await loadProspects();
    } catch (error) {
      errorBox.textContent =
        error instanceof Error
          ? error.message
          : 'Unable to initialize prospects.';

      errorBox.classList.remove('hidden');
      resultSummary.textContent = 'Unable to initialize prospects';
    }
  </script>
</AppLayout>
