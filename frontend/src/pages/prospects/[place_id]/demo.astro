---
import AppLayout from '../../../layouts/AppLayout.astro';

export const prerender = false;
const { place_id } = Astro.params;
---

<AppLayout title="Demo site" description="Build and review an optional one-page prospect demo before publishing.">
  <div id="demo-builder" data-place-id={place_id} class="mx-auto max-w-5xl space-y-6">
    <section class="rounded-lg border border-[var(--line)] bg-white p-5">
      <a href={`/prospects/${place_id}`} class="text-xs text-[var(--muted)] hover:underline">← Back to prospect</a>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">Build demo site</h2>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-[var(--muted)]">Create a controlled one-page concept for this prospect. Generate, inspect, then publish only after manual approval.</p>
        </div>
        <span class="rounded-full bg-[var(--surface-muted)] px-2.5 py-1 text-[11px] font-medium">Manual only</span>
      </div>
    </section>

    <section class="rounded-lg border border-[var(--line)] bg-white">
      <div class="border-b border-[var(--line)] px-5 py-4">
        <div class="text-sm font-medium">Existing demos</div>
        <div class="mt-1 text-xs text-[var(--muted)]">Review prior versions before generating another concept.</div>
      </div>
      <div id="existing-demos" class="divide-y divide-[var(--line)]"><div class="px-5 py-5 text-sm text-[var(--muted)]">Loading…</div></div>
    </section>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <section class="rounded-lg border border-[var(--line)] bg-white">
        <div class="border-b border-[var(--line)] px-5 py-4">
          <div id="business-name" class="text-sm font-medium">Loading…</div>
          <div class="mt-1 text-xs text-[var(--muted)]">Only confirmed Lead Desk facts and information you enter here are included.</div>
        </div>
        <form id="demo-form" class="space-y-5 p-5">
          <div>
            <label for="template-key" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">Template</label>
            <select id="template-key" class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm"></select>
            <div id="template-description" class="mt-1.5 text-xs leading-5 text-[var(--muted)]"></div>
            <label id="branding-row" class="mt-3 flex items-start gap-2 text-xs leading-5">
              <input id="use-site-branding" type="checkbox" checked class="mt-0.5" />
              <span>Use their logo and brand colour from their current website when it has them. Falls back to the niche colours.</span>
            </label>
          </div>
          <div id="ai-copy-row" class="hidden rounded-md border border-[var(--line)] bg-[var(--surface-muted)] p-3">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <label class="flex items-start gap-2 text-xs leading-5">
                <input id="use-ai-copy" type="checkbox" checked class="mt-0.5" />
                <span>Write the headline, intro, about and service lines with AI from their listing, reviews and site. Under 1 cent. Anything that makes an unbacked claim is dropped.</span>
              </label>
              <button id="write-copy" type="button" class="rounded-md border border-[var(--line)] bg-white px-3 py-2 text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40">Write copy now</button>
            </div>
            <div id="copy-status" class="mt-2 hidden text-[11px] leading-4 text-[var(--muted)]"></div>
          </div>
          <div>
            <label for="headline" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">Hero headline</label>
            <input id="headline" maxlength="120" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="subheadline" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">Hero supporting copy</label>
            <textarea id="subheadline" maxlength="280" rows="3" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm"></textarea>
          </div>
          <div id="about-row">
            <label for="about" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">About paragraph</label>
            <textarea id="about" maxlength="600" rows="3" placeholder="Leave blank for the standard wording" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm"></textarea>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="services" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">Services</label>
              <textarea id="services" rows="6" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm" placeholder="One per line, using the names on their site"></textarea>
              <div class="mt-1.5 text-[11px] leading-4 text-[var(--muted)]">Pre-filled from their website, then topped up with common services for the niche. Remove any they don't offer. Maximum 6.</div>
            </div>
            <div>
              <label for="service-areas" class="mb-1.5 block text-xs font-medium text-[var(--muted)]">Service areas</label>
              <textarea id="service-areas" rows="6" class="w-full rounded-md border border-[var(--line)] px-3 py-2 text-sm" placeholder="One town per line"></textarea>
              <div class="mt-1.5 text-[11px] leading-4 text-[var(--muted)]">Pre-filled with their town, then the nearest towns from your sweeps. Maximum 8.</div>
            </div>
          </div>
          <div class="rounded-md border border-[var(--line)] bg-[var(--surface-muted)] p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <div class="text-xs font-medium">Photos</div>
                <div class="mt-1 text-[11px] leading-4 text-[var(--muted)]">Photo set creates a hero, a work photo and a second photo in one go, about 30 cents. Hero only is about 10 cents. Charged to OpenRouter only when you click.</div>
              </div>
              <div class="flex gap-2">
                <button id="generate-set" type="button" class="rounded-md bg-[var(--dark)] px-3 py-2 text-xs font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">Generate photo set</button>
                <button id="generate-hero" type="button" class="rounded-md border border-[var(--line)] bg-white px-3 py-2 text-xs font-medium disabled:cursor-not-allowed disabled:opacity-40">Hero only</button>
              </div>
            </div>
            <input id="hero-direction" maxlength="300" placeholder="Optional: describe the place and light, not people. Such as: desert-modern home, dusk" class="mt-3 w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm" />
            <div id="hero-error" class="mt-2 hidden text-xs text-red-700"></div>
            <div id="hero-gallery" class="mt-3 hidden space-y-3"></div>
            <details class="mt-3">
              <summary class="cursor-pointer text-[11px] font-medium text-[var(--muted)]">Use your own image URLs instead</summary>
              <div class="mt-3 space-y-3">
                <div><label for="hero-image-url" class="mb-1 block text-[11px] font-medium text-[var(--muted)]">Hero image URL</label><input id="hero-image-url" type="url" maxlength="2048" placeholder="https://…" class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm" /></div>
                <div><label for="work-image-url" class="mb-1 block text-[11px] font-medium text-[var(--muted)]">Service / work image URL</label><input id="work-image-url" type="url" maxlength="2048" placeholder="https://…" class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm" /></div>
                <div><label for="secondary-image-url" class="mb-1 block text-[11px] font-medium text-[var(--muted)]">Secondary image URL</label><input id="secondary-image-url" type="url" maxlength="2048" placeholder="https://…" class="w-full rounded-md border border-[var(--line)] bg-white px-3 py-2 text-sm" /></div>
              </div>
            </details>
          </div>
          <div id="builder-error" class="hidden rounded-md border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700"></div>
          <button id="generate-demo" type="submit" class="w-full rounded-md bg-[var(--dark)] px-4 py-2.5 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-40">Generate review preview</button>
        </form>
      </section>

      <aside class="space-y-6">
        <section class="rounded-lg border border-[var(--line)] bg-white p-5">
          <div class="text-sm font-medium">Publishing guardrails</div>
          <ul class="mt-3 space-y-2 text-xs leading-5 text-[var(--muted)]"><li>• Static one-page concept only.</li><li>• No per-lead GitHub or Vercel project.</li><li>• Search indexing disabled.</li><li>• No fabricated reviews, licenses, credentials, or business claims.</li><li>• Publishing requires separate manual approval.</li></ul>
        </section>
      </aside>
    </div>

    <section id="review-panel" class="hidden rounded-lg border border-[var(--line)] bg-white p-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"><div><div class="text-sm font-medium">Ready for review</div><div class="mt-1 text-xs leading-5 text-[var(--muted)]">Inspect desktop and mobile presentation before publishing.</div></div><span class="rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-medium text-amber-800">Ready for review</span></div>
      <div class="mt-4 flex flex-wrap gap-2"><a id="preview-demo" target="_blank" rel="noreferrer" class="rounded-md border border-[var(--line)] bg-white px-4 py-2.5 text-sm font-medium">Open preview</a><button id="publish-demo" type="button" class="rounded-md bg-[var(--dark)] px-4 py-2.5 text-sm font-medium text-white">Approve & publish</button></div>
      <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">Publishing makes the unlisted demo URL accessible on the shared demo host. It remains noindex/noarchive and is not added to outreach automatically.</div>
      <div id="publish-error" class="mt-4 hidden rounded-md border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700"></div>
      <div id="publish-success" class="mt-4 hidden rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3"><div class="text-sm font-medium text-emerald-900">Demo published</div><div class="mt-1 text-xs text-emerald-800">The demo is live on the shared host. Nothing has been sent to the prospect.</div><div class="mt-3 flex flex-wrap gap-2"><a id="public-demo" target="_blank" rel="noreferrer" class="rounded-md bg-white px-3 py-2 text-xs font-medium text-emerald-900 ring-1 ring-emerald-200">View live demo</a><button id="copy-demo-url" type="button" class="rounded-md bg-white px-3 py-2 text-xs font-medium text-emerald-900 ring-1 ring-emerald-200">Copy URL</button></div></div>
    </section>
  </div>

  <script>
    type TemplateOption = { key: string; name: string; description: string };
    type DemoSummary = { id: string; status: string; template_key: string; public_url: string | null; created_at: string };
    type DemoOptions = { business_name: string; ai_copy_available?: boolean; templates: TemplateOption[]; defaults: { headline: string; subheadline: string; services: string[]; service_areas: string[]; hero_image_url?: string | null; work_image_url?: string | null; secondary_image_url?: string | null } };

    const required = <T extends HTMLElement>(selector: string): T => { const element = document.querySelector<T>(selector); if (!element) throw new Error(`Missing required element: ${selector}`); return element; };
    const escapeHtml = (value: unknown): string => String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');

    const root = required<HTMLElement>('#demo-builder');
    const rawPlaceId = root.dataset.placeId;
    if (!rawPlaceId) throw new Error('Missing prospect place ID');
    const placeId: string = rawPlaceId;

    const businessName = required('#business-name');
    const existingDemos = required('#existing-demos');
    const form = required<HTMLFormElement>('#demo-form');
    const templateSelect = required<HTMLSelectElement>('#template-key');
    const templateDescription = required('#template-description');
    const headline = required<HTMLInputElement>('#headline');
    const subheadline = required<HTMLTextAreaElement>('#subheadline');
    const services = required<HTMLTextAreaElement>('#services');
    const serviceAreas = required<HTMLTextAreaElement>('#service-areas');
    const heroImageUrl = required<HTMLInputElement>('#hero-image-url');
    const workImageUrl = required<HTMLInputElement>('#work-image-url');
    const secondaryImageUrl = required<HTMLInputElement>('#secondary-image-url');
    const generateButton = required<HTMLButtonElement>('#generate-demo');
    const builderError = required('#builder-error');
    const reviewPanel = required('#review-panel');
    const previewDemo = required<HTMLAnchorElement>('#preview-demo');
    const publishButton = required<HTMLButtonElement>('#publish-demo');
    const publishError = required('#publish-error');
    const publishSuccess = required('#publish-success');
    const publicDemo = required<HTMLAnchorElement>('#public-demo');
    const copyDemoUrl = required<HTMLButtonElement>('#copy-demo-url');

    const heroButton = required<HTMLButtonElement>('#generate-hero');
    const heroDirection = required<HTMLInputElement>('#hero-direction');
    const heroError = required('#hero-error');
    const heroGallery = required('#hero-gallery');

    type DemoMedia = { id: string; role: string; public_url: string };

    const generateSet = required<HTMLButtonElement>('#generate-set');
    const useSiteBranding = required<HTMLInputElement>('#use-site-branding');
    const roleInputs: Record<string, HTMLInputElement> = { hero: heroImageUrl, work: workImageUrl, secondary: secondaryImageUrl };
    const roleLabels: Record<string, string> = { hero: 'Hero', work: 'Work photo', secondary: 'Second photo' };

    function selectMedia(role: string, url: string): void {
      const input = roleInputs[role];
      if (!input) return;
      input.value = url;
      heroGallery.querySelectorAll<HTMLButtonElement>(`[data-role="${role}"]`).forEach((button) => {
        const active = button.dataset.url === url;
        button.classList.toggle('ring-2', active);
        button.classList.toggle('ring-[var(--accent)]', active);
      });
    }

    function renderGallery(media: DemoMedia[]): void {
      const groups = (['hero', 'work', 'secondary'] as const)
        .map((role) => ({ role, items: media.filter((item) => item.role === role) }))
        .filter((group) => group.items.length > 0);
      heroGallery.classList.toggle('hidden', groups.length === 0);
      heroGallery.innerHTML = groups.map((group) => `<div><div class="mb-1 text-[11px] font-medium text-[var(--muted)]">${roleLabels[group.role]}</div><div class="grid grid-cols-3 gap-2">${group.items.map((item) => `<button type="button" data-role="${group.role}" data-url="${escapeHtml(item.public_url)}" class="overflow-hidden rounded-md border border-[var(--line)]"><img src="${escapeHtml(item.public_url)}" alt="Generated ${roleLabels[group.role]} option" class="aspect-video w-full object-cover" /></button>`).join('')}</div></div>`).join('');
      heroGallery.querySelectorAll<HTMLButtonElement>('[data-role]').forEach((button) => {
        button.addEventListener('click', () => selectMedia(button.dataset.role ?? '', button.dataset.url ?? ''));
      });
      for (const group of groups) {
        const input = roleInputs[group.role];
        selectMedia(group.role, input.value || group.items[0].public_url);
      }
    }

    async function loadMedia(): Promise<DemoMedia[]> {
      const response = await fetch(`/api/demo-sites/prospects/${encodeURIComponent(placeId)}/media`, { headers: { Accept: 'application/json' } });
      if (!response.ok) return [];
      const media = (await response.json()) as DemoMedia[];
      renderGallery(media);
      return media;
    }

    async function generateRole(role: string): Promise<DemoMedia> {
      const response = await fetch(`/api/demo-sites/prospects/${encodeURIComponent(placeId)}/media/generate`, {
        method: 'POST',
        headers: { 'content-type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ role, direction: heroDirection.value.trim() || null }),
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.detail || `API returned ${response.status}`);
      return body as DemoMedia;
    }

    async function runGeneration(roles: string[], button: HTMLButtonElement, busyText: string, doneText: string): Promise<void> {
      heroButton.disabled = true;
      generateSet.disabled = true;
      heroError.classList.add('hidden');
      button.textContent = busyText;
      try {
        const results = await Promise.allSettled(roles.map((role) => generateRole(role)));
        const made = results.flatMap((result) => (result.status === 'fulfilled' ? [result.value] : []));
        for (const item of made) roleInputs[item.role].value = '';
        await loadMedia();
        for (const item of made) selectMedia(item.role, item.public_url);
        const failed = results.filter((result) => result.status === 'rejected') as PromiseRejectedResult[];
        if (failed.length) {
          const reason = failed[0].reason instanceof Error ? failed[0].reason.message : 'image generation failed';
          throw new Error(made.length ? `${failed.length} of ${roles.length} photos failed: ${reason}` : reason);
        }
      } catch (error) {
        heroError.textContent = error instanceof Error ? error.message : 'Unable to generate an image.';
        heroError.classList.remove('hidden');
      } finally {
        heroButton.disabled = false;
        generateSet.disabled = false;
        button.textContent = doneText;
      }
    }

    heroButton.addEventListener('click', () => runGeneration(['hero'], heroButton, 'Generating, about 20 seconds…', 'Another hero'));
    generateSet.addEventListener('click', () => runGeneration(['hero', 'work', 'secondary'], generateSet, 'Generating 3 photos, about 30 seconds…', 'Generate another set'));

    const aboutField = required<HTMLTextAreaElement>('#about');
    const aboutRow = required('#about-row');
    const aiCopyRow = required('#ai-copy-row');
    const useAiCopy = required<HTMLInputElement>('#use-ai-copy');
    const writeCopyButton = required<HTMLButtonElement>('#write-copy');
    const copyStatus = required('#copy-status');
    type DemoCopy = { headline?: string | null; subheadline?: string | null; about?: string | null; service_blurbs?: Record<string, string> };
    let serviceBlurbs: Record<string, string> = {};
    let copyWritten = false;
    let copyEdited = false;
    [headline, subheadline, aboutField].forEach((field) => field.addEventListener('input', () => { copyEdited = true; }));

    function showCopyStatus(text: string, isError = false): void {
      copyStatus.textContent = text;
      copyStatus.classList.toggle('text-red-700', isError);
      copyStatus.classList.remove('hidden');
    }

    async function writeCopy(): Promise<void> {
      writeCopyButton.disabled = true;
      writeCopyButton.textContent = 'Writing…';
      try {
        const response = await fetch(`/api/demo-sites/prospects/${encodeURIComponent(placeId)}/copy`, {
          method: 'POST',
          headers: { 'content-type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ services: items(services.value).slice(0, 6), service_areas: items(serviceAreas.value).slice(0, 8) }),
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.detail || `API returned ${response.status}`);
        const copy = body as DemoCopy;
        if (copy.headline) headline.value = copy.headline;
        if (copy.subheadline) subheadline.value = copy.subheadline;
        if (copy.about) aboutField.value = copy.about;
        serviceBlurbs = copy.service_blurbs ?? {};
        copyWritten = true;
        copyEdited = false;
        const blurbCount = Object.keys(serviceBlurbs).length;
        showCopyStatus(`AI copy filled in${blurbCount ? `, with ${blurbCount} service line${blurbCount === 1 ? '' : 's'}` : ''}. Edit anything before generating.`);
      } catch (error) {
        showCopyStatus(`AI copy skipped, using the standard wording. ${error instanceof Error ? error.message : ''}`, true);
      } finally {
        writeCopyButton.disabled = false;
        writeCopyButton.textContent = 'Rewrite copy';
      }
    }

    writeCopyButton.addEventListener('click', () => { void writeCopy(); });
    let aiCopyAvailable = false;

    let templates: TemplateOption[] = [];
    let currentDemoId: string | null = null;
    let currentPublicUrl: string | null = null;
    const items = (value: string): string[] => value.split(/[\n,;]+/).map((item) => item.trim()).filter(Boolean);

    const statusBadge = (status: string): string => {
      if (status === 'published') return '<span class="rounded-full bg-emerald-50 px-2 py-1 text-[11px] font-medium text-emerald-800">Published</span>';
      if (status === 'ready_for_review') return '<span class="rounded-full bg-amber-50 px-2 py-1 text-[11px] font-medium text-amber-800">Ready for review</span>';
      if (status === 'build_failed') return '<span class="rounded-full bg-red-50 px-2 py-1 text-[11px] font-medium text-red-800">Build failed</span>';
      return `<span class="rounded-full bg-[var(--surface-muted)] px-2 py-1 text-[11px] font-medium">${escapeHtml(status.replaceAll('_', ' '))}</span>`;
    };

    async function loadExistingDemos(): Promise<void> {
      const response = await fetch(`/api/demo-sites/prospects/${encodeURIComponent(placeId)}`, { headers: { Accept: 'application/json' } });
      const body = await response.json().catch(() => []);
      if (!response.ok) throw new Error(body.detail || `API returned ${response.status}`);
      const demos = body as DemoSummary[];
      existingDemos.innerHTML = demos.length ? demos.map((demo) => {
        const action = demo.status === 'published' && demo.public_url ? `<a href="${escapeHtml(demo.public_url)}" target="_blank" rel="noreferrer" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium">View live</a>` : demo.status === 'ready_for_review' ? `<a href="/api/demo-sites/${encodeURIComponent(demo.id)}/preview" target="_blank" rel="noreferrer" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-xs font-medium">Open preview</a>` : '';
        return `<div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between"><div><div class="flex flex-wrap items-center gap-2">${statusBadge(demo.status)}<span class="text-xs font-medium">${escapeHtml(demo.template_key)}</span></div><div class="mt-1 text-[11px] text-[var(--muted)]">Created ${escapeHtml(new Date(demo.created_at).toLocaleString())}</div></div>${action}</div>`;
      }).join('') : '<div class="px-5 py-5 text-sm text-[var(--muted)]">No demo sites have been created for this prospect.</div>';
    }

    const brandingRow = required('#branding-row');
    const updateTemplateDescription = (): void => {
      templateDescription.textContent = templates.find((item) => item.key === templateSelect.value)?.description ?? '';
      const isV4 = templateSelect.value.startsWith('premium-v4');
      brandingRow.classList.toggle('hidden', !isV4);
      aboutRow.classList.toggle('hidden', !isV4);
      aiCopyRow.classList.toggle('hidden', !isV4 || !aiCopyAvailable);
    };

    async function loadOptions(): Promise<void> {
      const response = await fetch(`/api/demo-sites/prospects/${encodeURIComponent(placeId)}/options`, { headers: { Accept: 'application/json' } });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.detail || `API returned ${response.status}`);
      const options = body as DemoOptions;
      businessName.textContent = options.business_name;
      aiCopyAvailable = Boolean(options.ai_copy_available);
      templates = options.templates;
      templateSelect.innerHTML = templates.map((item) => `<option value="${escapeHtml(item.key)}">${escapeHtml(item.name)}</option>`).join('');
      headline.value = options.defaults.headline ?? '';
      subheadline.value = options.defaults.subheadline ?? '';
      services.value = (options.defaults.services ?? []).join('\n');
      serviceAreas.value = (options.defaults.service_areas ?? []).join('\n');
      heroImageUrl.value = options.defaults.hero_image_url ?? '';
      workImageUrl.value = options.defaults.work_image_url ?? '';
      secondaryImageUrl.value = options.defaults.secondary_image_url ?? '';
      updateTemplateDescription();
    }

    templateSelect.addEventListener('change', updateTemplateDescription);

    form.addEventListener('submit', async (event) => {
      event.preventDefault(); builderError.classList.add('hidden'); reviewPanel.classList.add('hidden'); publishSuccess.classList.add('hidden'); generateButton.disabled = true;
      try {
        const isV4 = templateSelect.value.startsWith('premium-v4');
        if (isV4 && aiCopyAvailable && useAiCopy.checked && !copyWritten && !copyEdited) await writeCopy();
        const response = await fetch(`/api/demo-sites/prospects/${encodeURIComponent(placeId)}`, { method: 'POST', headers: { 'content-type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ template_key: templateSelect.value, headline: headline.value.trim() || null, subheadline: subheadline.value.trim() || null, services: items(services.value).slice(0, 6), service_areas: items(serviceAreas.value).slice(0, 8), hero_image_url: heroImageUrl.value.trim() || null, work_image_url: workImageUrl.value.trim() || null, secondary_image_url: secondaryImageUrl.value.trim() || null, use_site_branding: useSiteBranding.checked, about: templateSelect.value.startsWith('premium-v4') ? (aboutField.value.trim() || null) : null, service_blurbs: templateSelect.value.startsWith('premium-v4') ? serviceBlurbs : {} }) });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.detail || `API returned ${response.status}`);
        currentDemoId = body.id; currentPublicUrl = null; previewDemo.href = `/api/demo-sites/${encodeURIComponent(body.id)}/preview`; publishButton.disabled = false; publishButton.textContent = 'Approve & publish'; reviewPanel.classList.remove('hidden'); await loadExistingDemos(); reviewPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) { builderError.textContent = error instanceof Error ? error.message : 'Unable to generate demo site.'; builderError.classList.remove('hidden'); } finally { generateButton.disabled = false; }
    });

    publishButton.addEventListener('click', async () => {
      if (!currentDemoId) return; publishError.classList.add('hidden'); publishSuccess.classList.add('hidden'); publishButton.disabled = true;
      try {
        const response = await fetch(`/api/demo-sites/${encodeURIComponent(currentDemoId)}/publish`, { method: 'POST', headers: { Accept: 'application/json' } });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.detail || `API returned ${response.status}`); if (!body.public_url) throw new Error('Published demo did not return a public URL.');
        currentPublicUrl = body.public_url; publicDemo.href = body.public_url; publishSuccess.classList.remove('hidden'); publishButton.textContent = 'Published'; await loadExistingDemos();
      } catch (error) { publishError.textContent = error instanceof Error ? error.message : 'Unable to publish demo.'; publishError.classList.remove('hidden'); publishButton.disabled = false; }
    });

    copyDemoUrl.addEventListener('click', async () => { if (!currentPublicUrl) return; await navigator.clipboard.writeText(currentPublicUrl); copyDemoUrl.textContent = 'Copied'; window.setTimeout(() => { copyDemoUrl.textContent = 'Copy URL'; }, 1500); });
    Promise.all([loadOptions(), loadExistingDemos()]).then(loadMedia).catch((error) => { builderError.textContent = error instanceof Error ? error.message : 'Unable to load demo builder.'; builderError.classList.remove('hidden'); generateButton.disabled = true; });
  </script>
</AppLayout>
