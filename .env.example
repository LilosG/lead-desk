# PostgreSQL
POSTGRES_DB=lead_desk
POSTGRES_USER=lead_desk
POSTGRES_PASSWORD=

# Local PostgreSQL connection used by Lead Desk services
DATABASE_URL=

# Lead Desk application authentication
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# OpenRouter draft generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Gmail OAuth integration used by Lead Desk only to create drafts.
# Note: Google's gmail.compose OAuth scope also grants send permission,
# but Lead Desk exposes no send endpoint or send method.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=mike@lilosgrowth.com

# Google Places API (New) + PageSpeed Insights
GOOGLE_API_KEY=

SWEEP_EXECUTION_ENABLED=false
