# PostgreSQL
POSTGRES_DB=lead_desk
POSTGRES_USER=lead_desk
POSTGRES_PASSWORD=

# Local PostgreSQL connection used by Lead Desk services
DATABASE_URL=

# Lead Desk application authentication
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# Public production origin used for OAuth callbacks
PUBLIC_APP_URL=https://lead-desk-alpha.vercel.app

# 32 random bytes encoded as URL-safe base64. Used only to encrypt durable
# integration refresh tokens before they are stored in PostgreSQL.
INTEGRATION_ENCRYPTION_KEY=

# OpenRouter draft generation
# Approved models:
# - qwen/qwen3-30b-a3b-instruct-2507
# - deepseek/deepseek-chat-v3.1
# - anthropic/claude-haiku-4.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Existing Google OAuth client used by the in-app Gmail connection flow.
# Lead Desk requests gmail.compose because Gmail has no create-draft-only scope.
# The application itself intentionally exposes no Gmail send method or endpoint.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SENDER_EMAIL=mike@lilosgrowth.com

# Legacy migration-only fallback. New connections store the refresh token
# encrypted in PostgreSQL instead of keeping it in .env.
GMAIL_REFRESH_TOKEN=

# Google Places API (New) + PageSpeed Insights
GOOGLE_API_KEY=

SWEEP_EXECUTION_ENABLED=false
